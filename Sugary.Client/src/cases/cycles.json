{
  "why": "Which of her logged starts make her cycles, and which cycles count: one rule read by the app's forecast and trends (cycle.ts, countCycles) and the server's reminder and glucose by phase (CycleCounting). Both suites read these cases; a case one answers differently is a forecast, a reminder and a chart that disagree.",
  "cases": [
    { "name": "nothing to count before two starts", "starts": ["2026-10-08"], "expected": { "anchor": "2026-10-08", "cycles": [] } },
    {
      "name": "two cycles are taken as they are",
      "starts": ["2026-08-11", "2026-09-08", "2026-10-06"],
      "expected": {
        "anchor": "2026-10-06",
        "cycles": [
          { "start": "2026-08-11", "days": 28, "skipped": false, "joined": false },
          { "start": "2026-09-08", "days": 28, "skipped": false, "joined": false }
        ]
      }
    },
    {
      "name": "under three cycles, one over 45 days is a period she did not note",
      "starts": ["2026-07-01", "2026-08-20"],
      "expected": { "anchor": "2026-08-20", "cycles": [{ "start": "2026-07-01", "days": 50, "skipped": true, "joined": false }] }
    },
    {
      "name": "from three cycles, one half again longer than the median is a period she did not note",
      "starts": ["2026-05-19", "2026-06-16", "2026-08-11", "2026-09-09"],
      "expected": {
        "anchor": "2026-09-09",
        "cycles": [
          { "start": "2026-05-19", "days": 28, "skipped": false, "joined": false },
