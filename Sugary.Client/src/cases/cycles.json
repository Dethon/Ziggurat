          { "start": "2026-05-01", "days": 28, "skipped": false, "joined": false },
          { "start": "2026-05-29", "days": 28, "skipped": false, "joined": false },
          { "start": "2026-06-26", "days": 28, "skipped": false, "joined": false }
        ]
      }
    },
    {
