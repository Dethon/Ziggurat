      "expected": {
        "anchor": "2026-08-21",
        "cycles": [
          { "start": "2026-05-01", "days": 28, "skipped": false, "joined": false },
          { "start": "2026-05-29", "days": 28, "skipped": false, "joined": false },
          { "start": "2026-06-26", "days": 28, "skipped": false, "joined": true },
          { "start": "2026-07-24", "days": 28, "skipped": false, "joined": false }
        ]
      }
    },
    {
      "name": "spotting days before her period is not a start: the period is",
      "starts": ["2026-05-01", "2026-05-29", "2026-06-26", "2026-07-21", "2026-07-24", "2026-08-21"],
      "expected": {
        "anchor": "2026-08-21",
        "cycles": [
          { "start": "2026-05-01", "days": 28, "skipped": false, "joined": false },
          { "start": "2026-05-29", "days": 28, "skipped": false, "joined": false },
          { "start": "2026-06-26", "days": 28, "skipped": false, "joined": true },
          { "start": "2026-07-24", "days": 28, "skipped": false, "joined": false }
        ]
      }
    },
    {
      "name": "a latest start too soon after the one before is spotting: she is counted from the one before",
      "starts": ["2026-05-01", "2026-05-29", "2026-06-26", "2026-07-24", "2026-08-02"],
      "expected": {
        "anchor": "2026-07-24",
