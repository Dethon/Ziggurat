# Docker Compose Environment Variables
# Data directory path
REPOSITORY_PATH=..

# User and Group IDs - used by services that need file permissions
PUID=
PGID=

# Host GID of the `render` group, granted to the container that opens /dev/dri/renderD* (Lemonade).
# The nodes are root:render 0660 and --device preserves host ownership, so a wrong value here is a
# silent CPU fallback, not a startup error. Read it from the target host:
# getent group render | cut -d: -f3
RENDER_GID=

# Mcp secrets
# OpenRouter also carries the hosted judge (Jev), which the agent asks; without it every judgment
# answers absence. A household's web search and voice ask with the tenant kit's own key.
OPENROUTER__APIKEY=

# Lemonade chat host — somebody's own box on the LAN, e.g. http://192.168.5.55:13305/api/v1; empty
# means the feature is off. The agent and the observability container both read this line. The
# key only when the box checks a bearer token. The box itself must listen on the LAN: Lemonade's
# config.json needs "host": "0.0.0.0" (it defaults to localhost), plus a firewall rule for the port.
LemonadeChat__ApiUrl=
LemonadeChat__ApiKey=

# MCP servers — one credential per shared server, channel servers included: the server reads its
# own as MCP__SHAREDSECRET and the agent holds every one, presenting each server its own, so holding
# one opens no other. Any distinct non-empty values (openssl rand -hex 32 each); an unset one means
# that server refuses the agent, and the agent refuses to start without a credential for a server it
# is configured to dial. A household's own servers (the tenant kit's) and outposts hold no deployment
# secret: each opens its tunnel with a credential minted for it (mint-tunnel-credential).
MCP_SECRET_IDEALISTA=
MCP_SECRET_CHANNEL_SIGNALR=
MCP_SECRET_CHANNEL_TELEGRAM=
MCP_SECRET_SCHEDULING=
MCP_SECRET_TIMERS=
MCP_SECRET_SUGARY=

# The key the remembered logins were sealed with while the deployment ran the browser, which the
# household migration alone still reads: it opens each record filed under a person's name and seals
# it again under their user id. Web search now runs in the tenant kit, whose .env takes the same value
# (TenantKit/README.md); empty this once the migration has run and the home has moved.
LOGINS__STATEKEY=

# Household migration — the one-shot run that carries today's people into the home household
# (household-migration, under the `migrate` profile). Set it (openssl rand -hex 32) and recreate
# accounts before the run, then empty it and recreate accounts again: while it is set, whoever holds it
# can make the operator. Empty admits nobody.
HOUSEHOLD_MIGRATION_SECRET=

# Household configuration — the master key every household's data key is wrapped with, and so the one
# key to all of their secrets (OpenRouter, Idealista and Telegram keys): the accounts service's alone.
# The base64 of 32 random bytes: openssl rand -base64 32. Empty means no household secret can be saved
# or read. Losing it loses every household's secrets (they are entered again); to rotate it, put the
# new one here, recreate accounts, and run
#   docker exec -i accounts dotnet Accounts.dll rewrap-household-keys < previous-master.key
HOUSEHOLD_CONFIG_MASTER_KEY=

# Agent registration API — the secret SexyTime presents as `Authorization: Bearer <secret>` on
# every GET, POST and DELETE to /api/agents. Unset means every call is refused. The agent's relay
# also presents it to the accounts service to verify a tunnel's credential (CALLERS__agent), so unset
# refuses every tunnel too.
AGENTAPI__SHAREDSECRET=

# Telegram secrets — one token per bot. Who may use them is not listed here: a sender is admitted by
# the account their numeric Telegram id is linked to in the accounts service.
BOTS__0__BOTTOKEN=
BOTS__1__BOTTOKEN=

# SignalR secrets — the WEBPUSH__* keys are also the ones Sugary pushes pen reminders with
WEBPUSH__SUBJECT=
WEBPUSH__PUBLICKEY=
WEBPUSH__PRIVATEKEY=

# Cloudflare secrets
CF_API_TOKEN=

# The LAN address Lemonade listens on for the speech typist, e.g. 192.168.5.45. Empty means loopback
# only: the base compose file publishes nothing else past the proxy. A household's own tools
# (qBittorrent, Jackett, Home Assistant, Plex, filebrowser) are the tenant kit's.
LAN_BIND_ADDRESS=

# Redis password, required: the Redis container refuses to start without it and every service
# that reads Redis is handed it in its connection string. Hex or base64 without commas, which
# would end the connection string early: openssl rand -hex 32
REDIS_PASSWORD=
