# Docker Compose Environment Variables
# Data directory path
REPOSITORY_PATH=..
DATA_PATH=./volumes/data
VAULT_PATH=./volumes/vault
SANDBOX_HOME_PATH=./volumes/sandbox

# User and Group IDs - used by services that need file permissions
PUID=
PGID=

# Host GID of the `render` group, granted to the containers that open /dev/dri/renderD* (and
# /dev/kfd under the rocm override). The nodes are root:render 0660 and --device preserves host
# ownership, so a wrong value here is a silent CPU fallback, not a startup error. Read it from
# the target host: getent group render | cut -d: -f3
RENDER_GID=

# Mcp secrets
# OpenRouter also carries the hosted judge (Jev), so the agent, the web-search server and the voice
# channel all read this line; without it every judgment answers absence.
OPENROUTER__APIKEY=
JACKETT__APIKEY=
QBITTORRENT__USERNAME=
QBITTORRENT__PASSWORD=
BRAVESEARCH__APIKEY=
CAPSOLVER__APIKEY=
IDEALISTA__APIKEY=
IDEALISTA__SECRET=

# Lemonade chat host — somebody's own box on the LAN, e.g. http://192.168.5.55:13305/api/v1; empty
# means the feature is off. The agent and the observability container both read this line. The
# key only when the box checks a bearer token. The box itself must listen on the LAN: Lemonade's
# config.json needs "host": "0.0.0.0" (it defaults to localhost), plus a firewall rule for the port.
LemonadeChat__ApiUrl=
LemonadeChat__ApiKey=

# Outposts — the shared secret both directions present: the machine when it registers and
# keeps alive, the agent when it dials the machine back. Unset means no machine may attach.
# The same value goes on each machine running an outpost, as SHAREDSECRET — unprefixed there,
# because only the hub binds it inside a section.
OUTPOSTS__SHAREDSECRET=

# MCP servers — one credential per server, channel servers included: the server reads its own as
# MCP__SHAREDSECRET and the agent holds every one, presenting each server its own, so holding one
# (the sandbox's included) opens no other. Any distinct non-empty values (openssl rand -hex 32 each);
# an unset one means that server refuses the agent, and the agent refuses to start without a
# credential for a server it is configured to dial. Outposts keep their own secret above.
MCP_SECRET_LIBRARY=
MCP_SECRET_VAULT=
MCP_SECRET_SANDBOX=
MCP_SECRET_WEBSEARCH=
MCP_SECRET_IDEALISTA=
MCP_SECRET_HOMEASSISTANT=
MCP_SECRET_CHANNEL_SIGNALR=
MCP_SECRET_CHANNEL_TELEGRAM=
MCP_SECRET_SCHEDULING=
MCP_SECRET_PRINTER=
MCP_SECRET_TIMERS=
MCP_SECRET_SUGARY=
MCP_SECRET_CHANNEL_VOICE=

# Browse server — the key each person's remembered logins are sealed with in Redis: the base64 of
# 32 random bytes (openssl rand -base64 32). Empty leaves remembering off, so every login a person
# hands off lasts only until the browser restarts. Losing or changing it makes saved logins refuse
# rather than open, until it is put back or the person logs in again.
LOGINS__STATEKEY=

# Sugary app — the code typed once per phone to open the carb-counting app the Sugary server serves
# on its own port, when SUGARYAPP__REQUIREACCESSCODE is true. docker-compose.yml switches it off
# because the deployment is reached only through the VPN. With it on: any non-empty value; unset
# means every sign-in is refused. The standalone app
# called the same value AUTH__ACCESSCODE.
SUGARYAPP__ACCESSCODE=

# Agent registration API — the secret SexyTime presents as `Authorization: Bearer <secret>` on
# every GET, POST and DELETE to /api/agents. Unset means every call is refused.
AGENTAPI__SHAREDSECRET=

# Telegram secrets — ALLOWEDUSERIDS are numeric Telegram user ids (not usernames); a message is
# admitted only when its sender's id is listed
ALLOWEDUSERIDS__0=
ALLOWEDUSERIDS__1=
BOTS__0__BOTTOKEN=
BOTS__1__BOTTOKEN=

# SignalR secrets — the WEBPUSH__* keys are also the ones Sugary pushes pen reminders with
WEBPUSH__SUBJECT=
WEBPUSH__PUBLICKEY=
WEBPUSH__PRIVATEKEY=

# WebChat user identities
USERS__0__ID=
USERS__0__AVATARURL=
USERS__1__ID=
USERS__1__AVATARURL=

# Home Assistant secrets
HOMEASSISTANT__TOKEN=

# Music Assistant secrets (long-lived token from MA -> Settings -> Users; needed only for the
# podcast-episode listing, which Home Assistant cannot provide)
MUSICASSISTANT__TOKEN=

# Cloudflare secrets
CF_API_TOKEN=

# Voice channel secrets (double-underscore = config key). The voice hub, the timers server and the
# HA server read it, each named in its own environment; empty refuses every announcement.
Announce__Token=

# The LAN address the operator's own tools (qBittorrent, filebrowser, Jackett, Home Assistant,
# Lemonade for the speech typist) listen on, e.g. 192.168.5.45. Empty means loopback only: the
# base compose file publishes nothing else past the proxy.
LAN_BIND_ADDRESS=

# Redis password, required: the Redis container refuses to start without it and every service
# that reads Redis is handed it in its connection string. Hex or base64 without commas, which
# would end the connection string early: openssl rand -hex 32
REDIS_PASSWORD=
