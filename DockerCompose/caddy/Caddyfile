# How every host gets its certificate. The deployment's is Let's Encrypt through Cloudflare's DNS
# challenge; a stack on somebody's own machine (the smoke stack, docker-compose.override.smoke.yml)
# sets CADDY_TLS=internal and is served by Caddy's own local CA, with the rest of this file as it ships.
(tls_cloudflare) {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

(tls_internal) {
    tls internal
}

assistants.herfluffness.com {
    import tls_{$CADDY_TLS:cloudflare}

    # The chat client, its hub and the hub's upload and dictation endpoints ask the accounts service's
    # session check first. A signed-in request goes on carrying the person in three headers and a
    # fourth, the service's signed assertion of them, which copy_headers sets over any the client
    # sent; a signed-out page is sent to sign-in and back, and anything else is answered 401. Every
    # check names the channel it guards (?channel=), which the assertion then names: a turn it
    # starts must come on that channel.
    handle /hubs/* {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=signalr
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        reverse_proxy mcp-channel-signalr:8080
    }

    handle /api/attachments* {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=signalr
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        reverse_proxy mcp-channel-signalr:8080
    }

    handle /api/dictation* {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=signalr
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        reverse_proxy mcp-channel-signalr:8080
    }

    # SexyTime's server calls this with a secret of its own and the assertion the check signed for it.
    handle /api/agents* {
        reverse_proxy agent:8080
    }

    # A household's own server opens its one tunnel here: a WebSocket to the relay in the agent,
    # presenting the credential the operator minted for it, which the relay has the accounts service
    # verify on every open. The path exactly, and never behind the session check — a server is
    # nobody's browser. Everything the agent says to that server travels inside it. An outpost is
    # one such server, its credential minted for outpost-<name>; the exec bridge is never routed.
    handle /tunnel {
        reverse_proxy agent:8080
    }

    # A login handoff's live view and a person's logins page, served by the household's web search at
    # its own site: the relay in the agent forwards each exchange down that server's tunnel to its
    # pages listener, and its /mcp is never reachable this way. Not behind the session check — the
    # link is the credential, so a Telegram or voice person opens it from their phone. Before the
    # WebChat catch-all; reverse_proxy carries the live view's WebSocket upgrade as it is.
    handle /browse/* {
        reverse_proxy agent:8080
    }

    # Who holds which identity is asked by the deployment's servers on the compose network, never
    # through here; nor are the keys assertions verify with (/accounts/internal/jwks).
    handle /accounts/internal/* {
        respond 404
    }

    # The session check is forward_auth's, asked on the compose network: from a browser it would hand
    # whoever holds the cookie a signed assertion for any channel named, the admin API's included.
    handle /accounts/verify* {
        respond 404
    }

    # The admin API the chat client's admin area calls same-origin: behind the session check for the
    # admin channel, whose assertion is the one thing the accounts service believes about who a change
    # is from. After the internal API's refusal and before /accounts/*, which is never checked.
    handle /accounts/admin/* {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=admin
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        reverse_proxy accounts:8080
    }

    # The accounts service's own pages (sign-in, a link's enrollment) and the session check, all
    # under /accounts, which handle passes on as it is. The pages are never behind the check.
    handle /accounts/* {
        reverse_proxy accounts:8080
    }

    # The app's own files, signed out too, to any request that is not a page being opened and is not its
    # API: an installed app replaces its service worker by fetching the worker's script, and installs
    # the new one by fetching the files its shell caches, whether or not the person is signed in. A
    # phone holding a worker from before sign-in existed — one that answers every page, sign-in's
    # included, with its cached app — has no other way out. Opening a page (a navigation, or anything
    # asking for HTML) and the API still go through the session check below. After every path route:
    # Caddy orders a handle with a named matcher after those with a path.
    @shell {
        not header Sec-Fetch-Mode navigate
        not header Accept *text/html*
        not path /api/*
    }
    handle @shell {
        reverse_proxy webui:8080
    }

    handle {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=signalr
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        reverse_proxy webui:8080
    }
}

assistants-dashboard.herfluffness.com {
    import tls_{$CADDY_TLS:cloudflare}

    # Memory text and usage per person are the operator's: every request is checked for the
    # operator's session first. A member is refused, a signed-out page is sent to sign-in on the main
    # host and back. copy_headers deletes each named header from the request before setting it from
    # the check's answer, so a client cannot supply its own; a site-level request_header strip would
    # run after forward_auth in Caddy's directive order and blank the identity it copied.
    forward_auth accounts:8080 {
        uri /accounts/verify?role=operator&channel=dashboard
        copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
    }

    # Never the accounts service's internal API, as on every host that reaches the service.
    handle /accounts/internal/* {
        respond 404
    }

    # The household list's admin API, the operator's routes alone: past the operator's check above,
    # asked again for the admin channel, whose assertion copy_headers sets over the dashboard's and is
    # the one thing the accounts service believes. The owners' routes are the chat client's.
    handle /accounts/admin/operator/* {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=admin
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        reverse_proxy accounts:8080
    }

    handle {
        reverse_proxy observability:8080
    }
}

sexy.herfluffness.com {
    import tls_{$CADDY_TLS:cloudflare}

    # The chat hub and its endpoints, checked as on the main host.
    handle /hubs/* {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=signalr
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        reverse_proxy mcp-channel-signalr:8080
    }

    handle /api/attachments* {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=signalr
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        reverse_proxy mcp-channel-signalr:8080
    }

    handle /api/dictation* {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=signalr
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        reverse_proxy mcp-channel-signalr:8080
    }

    # SexyTime's server calls this with the agent API's secret and the X-Ziggurat-Assertion it was
    # handed by the check below; the agent acts for the person it names once it verifies, and only
    # beside the secret.
    handle /api/agents* {
        reverse_proxy agent:8080
    }

    # As on the main host: who holds which identity is asked on the compose network, never here.
    handle /accounts/internal/* {
        respond 404
    }

    # As on the main host: the session check is forward_auth's, never a browser's.
    handle /accounts/verify* {
        respond 404
    }

    # The admin API is the main host's chat client's; nothing here calls it, so it is refused rather
    # than handed to the accounts service past no session check.
    handle /accounts/admin/* {
        respond 404
    }

    # The accounts service's routes, as on the main host, so a page here asks /accounts/me
    # same-origin. Never behind the check: sign-in opens signed out.
    handle /accounts/* {
        reverse_proxy accounts:8080
    }

    # SexyTime itself is behind the same sign-in as the chat client: a signed-out page is sent to
    # sign-in on the main host and back here, a signed-out call to its API is answered 401.
    handle {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=sexytime
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        reverse_proxy sexytime:8080
    }
}

sugary.herfluffness.com {
    import tls_{$CADDY_TLS:cloudflare}

    # The agent's /mcp is for the deployment alone; a person's phone only ever needs the app and its API.
    handle /mcp* {
        respond 404
    }

    # As on the main host: who holds which identity is asked on the compose network, never here.
    handle /accounts/internal/* {
        respond 404
    }

    # As on the main host: the session check is forward_auth's, never a browser's.
    handle /accounts/verify* {
        respond 404
    }

    # As on SexyTime's host: the admin API is the main host's chat client's.
    handle /accounts/admin/* {
        respond 404
    }

    # The accounts service's routes, as on the main host, so the app sends a signed-out person to
    # sign in, and back, same-origin. Never behind the check: sign-in opens signed out.
    handle /accounts/* {
        reverse_proxy accounts:8080
    }

    # Each person's own log, behind the same sign-in as the chat client: the app and its API act
    # for the person the check names in the headers it copies, over any the client sent. A
    # signed-out page is sent to sign-in and back here, a signed-out call to the API is answered 401.
    # The app's own files, signed out too, to any request that is not a page being opened and is not its
    # API: an installed app replaces its service worker by fetching the worker's script, and installs
    # the new one by fetching the files its shell caches, whether or not the person is signed in. A
    # phone holding a worker from before sign-in existed — one that answers every page, sign-in's
    # included, with its cached app — has no other way out. Opening a page (a navigation, or anything
    # asking for HTML) and the API still go through the session check below. After every path route:
    # Caddy orders a handle with a named matcher after those with a path.
    @shell {
        not header Sec-Fetch-Mode navigate
        not header Accept *text/html*
        not path /api/*
    }
    handle @shell {
        reverse_proxy mcp-sugary:8080
    }

    handle {
        forward_auth accounts:8080 {
            uri /accounts/verify?channel=sugary
            copy_headers X-Ziggurat-User X-Ziggurat-Tenant X-Ziggurat-Roles X-Ziggurat-Assertion
        }
        # A filmed meal is up to 200 MiB plus four photos (McpServerSugary's MaxClipBytes).
        request_body {
            max_size 230MiB
        }
        reverse_proxy mcp-sugary:8080
    }
}
