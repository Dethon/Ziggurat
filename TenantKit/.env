# The tenant kit's own settings and secrets: everything here is the household's, none of it the
# deployment's. Placeholders only — fill them in on the machine that runs the kit.

# Paths, relative to this folder
REPOSITORY_PATH=..
DATA_PATH=./volumes/data
VAULT_PATH=./volumes/vault
SANDBOX_HOME_PATH=./volumes/sandbox

# User and group the volume-writing servers and the LAN tools run as, and the host's render group
# (getent group render | cut -d: -f3), granted to the sandbox for /dev/dri.
PUID=
PGID=
RENDER_GID=

# The LAN address the household's own tools (qBittorrent, Jackett, Home Assistant, filebrowser) listen
# on, e.g. 192.168.5.45. Empty means loopback only. Plex is on the host's network and needs none.
LAN_BIND_ADDRESS=

# The household's printer, by its IPP address on the LAN, e.g. ipp://192.168.4.59:631/ipp/print.
PRINTER_URI=

# The deployment's main host, e.g. assistants.example.com: every server opens its tunnel to
# wss://<it>/tunnel, and a login handoff's link is https://<it>/browse/...
DEPLOYMENT_HOST=

# One tunnel credential per server, each minted for that server's name by the deployment's operator
# (docker exec accounts dotnet Accounts.dll mint-tunnel-credential --household <id> --server <name>),
# shown once. Holding one opens that server's tunnel and nothing else.
TUNNEL_CREDENTIAL_WEBSEARCH=
TUNNEL_CREDENTIAL_VAULT=
TUNNEL_CREDENTIAL_LIBRARY=
TUNNEL_CREDENTIAL_SANDBOX=
TUNNEL_CREDENTIAL_PRINTER=
TUNNEL_CREDENTIAL_HOMEASSISTANT=
TUNNEL_CREDENTIAL_VOICE=

# The kit's own Redis (web search's logins and links, the library's download routing): hex or base64
# without commas, which would end the connection string early. openssl rand -hex 32
KIT_REDIS_PASSWORD=

# Seals each person's remembered logins in the kit's Redis: the base64 of 32 random bytes (openssl
# rand -base64 32). Empty leaves remembering off. Moving the home, it must be the value the deployment
# sealed them with, or every record carried over refuses to open.
LOGINS__STATEKEY=

# The household's own keys for the services its servers call out to. OpenRouter also carries Jev,
# which web search and voice ask.
OPENROUTER__APIKEY=
BRAVESEARCH__APIKEY=
CAPSOLVER__APIKEY=
JACKETT__APIKEY=
QBITTORRENT__USERNAME=
QBITTORRENT__PASSWORD=

# Home Assistant's long-lived token, and Music Assistant's (Settings -> Users; only for the
# podcast-episode listing).
HOMEASSISTANT__TOKEN=
MUSICASSISTANT__TOKEN=

# What Home Assistant's watch callback and the Home Assistant server present to the kit's voice
# server: the kit's own (openssl rand -hex 32). Empty refuses every announcement Home Assistant asks
# for. The deployment's timers server never holds it: the relay presents voice's tunnel credential.
Announce__Token=

# The STT model voice asks the deployment's Lemonade for: empty is Whisper-Large-v3-Turbo, and it
# must be the deployment's STT_MODEL.
STT_MODEL=

# Speech extraction's tunables; empty takes each one's default (README.md).
Tse__Mode=
Tse__TimeoutMs=
Tse__NoiseFloorThreshold=
Tse__AuditDir=
TSE_TORCH_THREADS=
TSE_ONNX=
