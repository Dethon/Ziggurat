        "Judgments": {
            "Enabled": true,
            "Gate": { "SkipAtOrBelow": 0.1 },
            "Verify": { "Supported": 0.5, "AboutUser": 0.5, "Durable": 0.5, "NotAQuestion": 0.5 },
            "Pairs": { "MaxClusterMemories": 12 }
        }
    },
    "openRouter": {
        "apiUrl": "https://openrouter.ai/api/v1/",
        "apiKey": "",
        "maxContextTokens": 800000
