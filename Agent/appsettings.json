{
    "Memory": {
        "Embedding": {
            "BaseAddress": "http://lemonade:13305/api/v1/",
            "Model": "Qwen3-Embedding-0.6B-GGUF",
            "Dimension": 1024,
            "TimeoutSeconds": 5
        },
        "Extraction": {
            "Model": "openai/gpt-5.6-luna",
            "MaxCandidatesPerMessage": 5,
            "SimilarityThreshold": 0.85,
            "WindowMixedTurns": 6
        },
        "Dreaming": {
            "CronSchedule": "0 3 * * *",
            "Model": "openai/gpt-5.6-luna",
            "DecayDays": 30,
            "DecayFactor": 0.9,
            "DecayFloor": 0.1
        },
        "Recall": {
            "DefaultLimit": 10,
            "IncludePersonalityProfile": true,
            "WindowUserTurns": 3
        }
    },
    "openRouter": {
        "apiUrl": "https://openrouter.ai/api/v1/",
        "apiKey": "",
        "maxContextTokens": 800000
    },
    "redis": {
        "connectionString": "redis:6379"
    },
    "attachments": {
        "hydrationDepthMessages": 20
    },
    "readImages": {
        "maxInlineBytes": 15728640
    },
    "patchableModels": [
        { "id": "openai/gpt-5.6-luna", "name": "GPT 5.6 Luna" },
        { "id": "z-ai/glm-5.2", "name": "GLM 5.2" },
        { "id": "~deepseek/deepseek-v4-flash-latest", "name": "DeepSeek V4 Flash" }
    ],
    "agentDefaults": {
        "fallback": "jonas",
        "byChannel": {
            "voice": "nabu"
        }
    },
    "agents": [
        {
            "id": "jack",
            "name": "Jack",
            "description": "Download assistant (library/torrent search and downloads).",
            "model": "openai/gpt-5.6-luna",
            "reasoningEffort": "low",
            "mcpServerEndpoints": [
                "http://mcp-library:8080/mcp",
                "http://mcp-websearch:8080/mcp"
            ],
            "enabledFeatures": [
                "filesystem.glob",
                "filesystem.move",
                "filesystem.info",
                "filesystem.read",
                "filesystem.remove"
            ],
            "whitelistPatterns": [
                "domain__filesystem*",
                "mcp__mcp-library*",
                "mcp__mcp-websearch*"
            ]
        },
        {
            "id": "jonas",
            "usesOutposts": true,
            "name": "Jonas",
            "description": "General-purpose personal assistant (vault notes, web search, real-estate, home automation).",
            "model": "openai/gpt-5.6-luna",
            "reasoningEffort": "medium",
            "mcpServerEndpoints": [
                "http://mcp-vault:8080/mcp",
                "http://mcp-sandbox:8080/mcp",
                "http://mcp-websearch:8080/mcp",
                "http://mcp-idealista:8080/mcp",
                "http://mcp-homeassistant:8080/mcp",
                "http://mcp-scheduling:8080/mcp",
                "http://mcp-printer:8080/mcp",
                "http://mcp-timers:8080/mcp"
            ],
            "enabledFeatures": [
                "filesystem",
                "subagents",
                "memory"
            ],
            "whitelistPatterns": [
                "domain__filesystem*",
                "mcp__mcp-websearch*",
                "mcp__mcp-idealista*",
                "domain__subagents*",
                "domain__memory*"
            ]
        },
        {
            "id": "nabu",
            "usesOutposts": true,
            "name": "Nabu",
            "description": "Voice assistant with the full personal-assistant toolset (vault notes, web search, real-estate, home automation, printing, timers, scheduled tasks), driven by speech; every reply is spoken aloud, so answers are one short sentence of plain words — no formatting, no narration, no explanation.",
            "model": "openai/gpt-5.6-luna",
            "providerRouting": {
                "sort": "latency",
                "preferredMinThroughput": 70
            },
            "reasoningEffort": "low",
            "language": "es",
            "promptSections": [
                "voice"
            ],
            "mcpServerEndpoints": [
                "http://mcp-vault:8080/mcp",
                "http://mcp-sandbox:8080/mcp",
                "http://mcp-websearch:8080/mcp",
                "http://mcp-idealista:8080/mcp",
                "http://mcp-homeassistant:8080/mcp",
                "http://mcp-scheduling:8080/mcp",
                "http://mcp-printer:8080/mcp",
                "http://mcp-timers:8080/mcp"
            ],
            "enabledFeatures": [
                "filesystem",
                "subagents",
                "memory"
            ],
            "whitelistPatterns": [
                "domain__filesystem*",
                "mcp__mcp-websearch*",
                "mcp__mcp-idealista*",
                "domain__subagents*",
                "domain__memory*"
            ]
        }
    ],
    "subAgents": [
        {
            "id": "jonas-worker",
            "usesOutposts": true,
            "name": "Jonas Worker",
            "description": "A worker subagent with the same toolset as Jonas for delegating tasks",
            "model": "openai/gpt-5.6-luna",
            "providerRouting": {
                "sort": "throughput"
            },
            "reasoningEffort": "medium",
            "mcpServerEndpoints": [
                "http://mcp-vault:8080/mcp",
                "http://mcp-sandbox:8080/mcp",
                "http://mcp-websearch:8080/mcp",
                "http://mcp-idealista:8080/mcp",
                "http://mcp-homeassistant:8080/mcp"
            ],
            "enabledFeatures": [
                "filesystem"
            ],
            "maxExecutionSeconds": 1800
        }
    ],
    "channelEndpoints": [
        {
            "channelId": "signalr",
            "endpoint": "http://mcp-channel-signalr:8080/mcp"
        },
        {
            "channelId": "telegram",
            "endpoint": "http://mcp-channel-telegram:8080/mcp"
        },
        {
            "channelId": "servicebus",
            "endpoint": "http://mcp-channel-servicebus:8080/mcp"
        },
        {
            "channelId": "scheduling",
            "endpoint": "http://mcp-scheduling:8080/mcp"
        },
        {
            "channelId": "voice",
            "endpoint": "http://mcp-channel-voice:8080/mcp",
            "attachOnly": true
        },
        {
            "channelId": "library",
            "endpoint": "http://mcp-library:8080/mcp"
        }
    ],
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "System.Net.Http.HttpClient": "Warning"
        }
    }
}
