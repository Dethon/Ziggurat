@page "/tokens"
@using Dashboard.Client.State.Tokens
@using Domain.DTOs.Metrics
@using Domain.DTOs.Metrics.Enums
@using static Dashboard.Client.Components.PillSelector
@inject MetricFamilyTable Families

<div class="tokens-page">
    <MetricControls TStore="TokensStore" TState="TokensState"
                    Title="Token Usage"
                    Family="Families.Tokens"
                    DimensionOptions="DimensionOptions"
                    MetricOptions="MetricOptions">
        <ChildContent Context="state">
            <section class="kpi-row">
                <KpiCard Label="Input Tokens" Value="@state.Events.Sum(e => (long)e.InputTokens).ToString("N0")" Color="var(--accent-blue)" />
                <KpiCard Label="Output Tokens" Value="@state.Events.Sum(e => (long)e.OutputTokens).ToString("N0")" Color="var(--accent-purple)" />
                <KpiCard Label="Cost" Value="@($"${state.Events.Sum(e => e.Cost):F2}")" Color="var(--accent-green)" />
                <KpiCard Label="Truncations" Value="@state.Truncations.ToString("N0")" Color="var(--accent-yellow)" />
            </section>

            <section class="section">
                <DynamicChart Data="state.Breakdown" ChartType="DynamicChart.ChartMode.Donut"
                              MetricLabel="@(MetricOptions.FirstOrDefault(o => o.Value == state.Metric.ToString())?.Label ?? "")"
                              Unit="@(state.Metric == TokenMetric.Cost ? "$" : "")"
                              UseFullLabels="@(state.GroupBy == TokenDimension.Model)" />
            </section>

            <section class="section">
                <h3>Recent Token Events</h3>
                <div class="events-table">
                    <div class="table-header">
                        <span class='sortable @SortClass("Time")' @onclick='() => SortBy("Time")'>Time @SortIndicator("Time")</span>
                        <span class='sortable @SortClass("Sender")' @onclick='() => SortBy("Sender")'>Sender @SortIndicator("Sender")</span>
                        <span class='sortable @SortClass("Model")' @onclick='() => SortBy("Model")'>Model @SortIndicator("Model")</span>
                        <span class='sortable @SortClass("Input")' @onclick='() => SortBy("Input")'>Input @SortIndicator("Input")</span>
                        <span class='sortable @SortClass("Output")' @onclick='() => SortBy("Output")'>Output @SortIndicator("Output")</span>
                        <span class='sortable @SortClass("Cost")' @onclick='() => SortBy("Cost")'>Cost @SortIndicator("Cost")</span>
                    </div>
                    @foreach (var evt in GetSortedEvents(state))
                    {
                        <div class="table-row">
                            <span>@evt.Timestamp.ToString("dd/MM HH:mm:ss")</span>
                            <span>@evt.Sender</span>
                            <span>@evt.Model</span>
                            <span>@evt.InputTokens.ToString("N0")</span>
                            <span>@evt.OutputTokens.ToString("N0")</span>
                            <span>@($"${evt.Cost:F4}")</span>
                        </div>
                    }
                </div>
            </section>
        </ChildContent>
    </MetricControls>
</div>

@code {
    private static readonly IReadOnlyList<PillOption> DimensionOptions =
    [
        new("User", nameof(TokenDimension.User)),
        new("Model", nameof(TokenDimension.Model)),
        new("Agent", nameof(TokenDimension.Agent)),
    ];

    private static readonly IReadOnlyList<PillOption> MetricOptions =
    [
        new("Tokens", nameof(TokenMetric.Tokens)),
        new("Cost ($)", nameof(TokenMetric.Cost)),
        new("Truncations", nameof(TokenMetric.TruncationCount)),
        new("Msgs dropped", nameof(TokenMetric.MessagesDropped)),
        new("Tokens trimmed", nameof(TokenMetric.TokensTrimmed)),
    ];

    private string _sortColumn = "Time";
    private bool _sortAsc;

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = false; }
    }

    private IEnumerable<TokenUsageEvent> GetSortedEvents(TokensState state)
    {
        var events = state.Events.TakeLast(50).AsEnumerable();
        Func<TokenUsageEvent, object> keySelector = _sortColumn switch
        {
            "Sender" => e => e.Sender,
            "Model" => e => e.Model,
            "Input" => e => e.InputTokens,
            "Output" => e => e.OutputTokens,
            "Cost" => e => e.Cost,
            _ => e => e.Timestamp
        };
        return _sortAsc ? events.OrderBy(keySelector) : events.OrderByDescending(keySelector);
    }

    private string SortClass(string column) => _sortColumn == column ? "sorted" : "";
    private MarkupString SortIndicator(string column) => SortArrow.For(column, _sortColumn, _sortAsc);
}

<style>
    .tokens-page { display: flex; flex-direction: column; gap: 1.5rem; }
    .kpi-row { display: flex; gap: 1rem; flex-wrap: wrap; }
    .section h3 { font-size: 1rem; margin-bottom: 0.8rem; color: var(--text-secondary); }
    .events-table { display: flex; flex-direction: column; gap: 2px; }
    .table-header, .table-row { display: grid; grid-template-columns: 135px minmax(0, 1fr) minmax(0, 1fr) 90px 90px 90px; gap: 0.5rem; padding: 0.4rem 0.8rem; font-size: 0.82rem; }
    .table-header { background: var(--bg-secondary); color: var(--text-secondary); font-weight: 600; border-radius: 4px; text-transform: uppercase; font-size: 0.7rem; }
    .sortable { cursor: pointer; user-select: none; }
    .sortable:hover { color: var(--text-primary); }
    .sortable.sorted { color: var(--text-primary); }
    .table-row { background: var(--bg-card); border-radius: 4px; }
    .table-row:hover { background: rgba(255,255,255,0.03); }

    @@media (max-width: 768px) {
        .events-table { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .table-header, .table-row { grid-template-columns: 110px minmax(0, 1fr) minmax(0, 1fr) 70px 70px 70px; font-size: 0.72rem; padding: 0.4rem 0.5rem; min-width: 525px; }
        .table-row span { word-break: break-word; }
    }
</style>
