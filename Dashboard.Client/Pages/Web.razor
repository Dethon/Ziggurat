@page "/web"
@using Dashboard.Client.State.Web
@using Domain.DTOs.Metrics
@using Domain.DTOs.Metrics.Enums
@using static Dashboard.Client.Components.PillSelector
@inject WebStore Store
@inject MetricFamilyTable Families

<div class="web-page">
    <MetricControls TStore="WebStore" TState="WebState"
                    Title="Web"
                    Family="Families.Web"
                    DimensionOptions="DimensionOptions"
                    MetricOptions="MetricOptions"
                    ExtraChoices="_extraChoices">
        <ExtraControls Context="controls">
            <PillSelector Label="Aggregate" Options="AggOptions" Value="@_aggregation.Current"
                          OnChanged="value => controls.ChangeAsync(_aggregation, value)" />
        </ExtraControls>
        <ChildContent Context="state">
            <section class="kpi-row">
                <KpiCard Label="Overlays met" Value="@state.Events.Count.ToString("N0")" Color="var(--accent-blue)" />
                <KpiCard Label="Closed by pattern" Value="@Share(state, ModalDismissalOutcomes.Selector, ModalDismissalOutcomes.Text)" Color="var(--accent-green)" />
                <KpiCard Label="Closed by judgment" Value="@Share(state, ModalDismissalOutcomes.Judgment)" Color="var(--accent-green)" />
                <KpiCard Label="Left standing" Value="@Share(state, ModalDismissalOutcomes.LeftStanding)" Color="var(--accent-red)" />
                <KpiCard Label="Median judgment" Value="@($"{MedianLatency(state):F0}ms")" Color="var(--accent-yellow)" />
            </section>

            <section class="section">
                <h3>Outcomes over time</h3>
                <LatencyTrendChart Series="state.Trend" />
            </section>

            <section class="section">
                <DynamicChart Data="state.Breakdown" ChartType="DynamicChart.ChartMode.HorizontalBar"
                              MetricLabel="@(MetricOptions.FirstOrDefault(o => o.Value == state.Metric.ToString())?.Label ?? "")"
                              Unit="@GetMetricUnit(state)" />
            </section>

            <section class="section">
                <h3>Recent overlays</h3>
                <div class="events-table">
                    <div class="table-header">
                        <span>Time</span>
                        <span>Kind</span>
                        <span>Outcome</span>
                        <span>Closed by</span>
                        <span>Button</span>
                        <span>Confidence</span>
                        <span>Latency</span>
                    </div>
                    @foreach (var evt in state.Events.TakeLast(50).Reverse())
                    {
                        <div class="table-row">
                            <span>@evt.Timestamp.ToString("dd/MM HH:mm:ss")</span>
                            <span>@evt.Kind</span>
                            <span class="@OutcomeClass(evt.Outcome)">@evt.Outcome</span>
                            <span title="@evt.Selector">@evt.Selector</span>
                            <span>@evt.ButtonText</span>
                            <span>@(evt.Confidence is { } c ? c.ToString("F2") : "")</span>
                            <span>@(evt.DurationMs is { } d ? $"{d} ms" : "")</span>
                        </div>
                    }
                    @if (!state.Events.Any())
                    {
                        <p class="no-data">No overlays recorded</p>
                    }
                </div>
            </section>
        </ChildContent>
    </MetricControls>
</div>

@code {
    private MetricChoice _aggregation = default!;
    private IReadOnlyList<MetricChoice> _extraChoices = [];

    protected override void OnInitialized()
    {
        _aggregation = MetricChoice.For("agg", () => Store.State.Agg, Store.SetAgg);
        _extraChoices = [_aggregation];
    }

    private static readonly IReadOnlyList<PillOption> DimensionOptions =
    [
        new("Kind", nameof(ModalDismissalDimension.Kind)),
        new("Outcome", nameof(ModalDismissalDimension.Outcome)),
    ];

    private static readonly IReadOnlyList<PillOption> MetricOptions =
    [
        new("Overlays", nameof(ModalDismissalMetric.Count)),
        new("Judgment latency (ms)", nameof(ModalDismissalMetric.LatencyMs)),
    ];

    private static readonly IReadOnlyList<PillOption> AggOptions =
    [
        new("Avg", nameof(Aggregation.Avg)),
        new("P50", nameof(Aggregation.P50)),
        new("P95", nameof(Aggregation.P95)),
        new("Max", nameof(Aggregation.Max)),
    ];

    private static string Share(WebState state, params string[] outcomes)
    {
        var total = state.Events.Count;
        var count = state.Events.Count(e => outcomes.Contains(e.Outcome));
        return total == 0 ? "0" : $"{count:N0} ({100.0 * count / total:F0}%)";
    }

    private static double MedianLatency(WebState state)
    {
        var durations = state.Events
            .Where(e => e.DurationMs is not null)
            .Select(e => e.DurationMs!.Value)
            .OrderBy(x => x)
            .ToList();
        return durations.Count > 0 ? durations[durations.Count / 2] : 0;
    }

    // Mirrors the query service: a metric whose name ends in Ms is a duration.
    private static string GetMetricUnit(WebState state) =>
        state.Metric.ToString().EndsWith("Ms", StringComparison.Ordinal) ? "ms" : "";

    private static string OutcomeClass(string outcome) => outcome switch
    {
        ModalDismissalOutcomes.LeftStanding => "status-err",
        _ => "status-ok"
    };
}

<style>
    .web-page {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .kpi-row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .section h3 {
        font-size: 1rem;
        margin-bottom: 0.8rem;
        color: var(--text-secondary);
    }

    .events-table {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .table-header, .table-row {
        display: grid;
        grid-template-columns: 135px 110px 120px minmax(0, 1.6fr) minmax(0, 1.2fr) 90px 80px;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        font-size: 0.82rem;
    }

    .table-header {
        background: var(--bg-secondary);
        color: var(--text-secondary);
        font-weight: 600;
        border-radius: 4px;
        text-transform: uppercase;
        font-size: 0.7rem;
    }

    .table-row {
        background: var(--bg-card);
        border-radius: 4px;
    }

    .table-row:hover {
        background: rgba(255,255,255,0.03);
    }

    .table-row span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .status-ok {
        color: var(--accent-green);
    }

    .status-err {
        color: var(--accent-red);
    }

    .no-data {
        color: var(--text-secondary);
        font-size: 0.85rem;
        padding: 0.5rem 0.8rem;
    }

    @@media (max-width: 768px) {
        .events-table {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .table-header, .table-row {
            grid-template-columns: 110px 90px 100px minmax(0, 1.6fr) minmax(0, 1.2fr) 70px 70px;
            font-size: 0.72rem;
            padding: 0.4rem 0.5rem;
            min-width: 700px;
        }
    }
</style>
