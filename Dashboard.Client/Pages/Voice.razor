@page "/voice"
@using Dashboard.Client.State.Voice
@using Domain.DTOs.Metrics
@using Domain.DTOs.Metrics.Enums
@using static Dashboard.Client.Components.PillSelector
@inject VoiceStore Store
@inject MetricFamilyTable Families

<div class="voice-page">
    <MetricControls TStore="VoiceStore" TState="VoiceState"
                    Title="Voice"
                    Description="Satellites, transcription and how soon a spoken answer starts."
                    Family="Families.Voice"
                    DimensionOptions="DimensionOptions"
                    MetricOptions="MetricOptions"
                    ExtraChoices="_extraChoices">
        <ExtraControls Context="controls">
            <PillSelector Label="Aggregate" Options="AggOptions" Value="@_aggregation.Current"
                          OnChanged="value => controls.ChangeAsync(_aggregation, value)" />
        </ExtraControls>
        <ChildContent Context="state">
            <section class="kpi-row">
                <KpiCard Label="Utterances" Value="@state.Events.Count(e => e.Metric == VoiceMetric.UtteranceTranscribed).ToString("N0")" Color="var(--accent-blue)" />
                <KpiCard Label="Median speech → audio" Value="@($"{MedianLatency(state):F0}ms")" Color="var(--accent-yellow)" />
                <KpiCard Label="STT errors" Value="@state.Events.Count(e => e.Metric == VoiceMetric.SttError).ToString("N0")" Color="var(--accent-red)" />
                <KpiCard Label="TTS errors" Value="@state.Events.Count(e => e.Metric == VoiceMetric.TtsError).ToString("N0")" Color="var(--accent-red)" />
            </section>

            <section class="section">
                <h3>Breakdown</h3>
                <DynamicChart Data="state.Breakdown" ChartType="DynamicChart.ChartMode.HorizontalBar"
                              MetricLabel="@(MetricOptions.FirstOrDefault(o => o.Value == state.Metric.ToString())?.Label ?? "")"
                              Unit="@GetMetricUnit(state)" />
            </section>

            <section class="section">
                <h3>Recent voice events</h3>
                <div class="events-table tbl-voice">
                    <div class="table-header">
                        <span class='sortable @SortClass("Time")' @onclick='() => SortBy("Time")'>Time <SortArrow Column="Time" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Satellite")' @onclick='() => SortBy("Satellite")'>Satellite <SortArrow Column="Satellite" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Room")' @onclick='() => SortBy("Room")'>Room <SortArrow Column="Room" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Identity")' @onclick='() => SortBy("Identity")'>Identity <SortArrow Column="Identity" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Metric")' @onclick='() => SortBy("Metric")'>Metric <SortArrow Column="Metric" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Duration")' @onclick='() => SortBy("Duration")'>Duration <SortArrow Column="Duration" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Outcome")' @onclick='() => SortBy("Outcome")'>Outcome <SortArrow Column="Outcome" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Error")' @onclick='() => SortBy("Error")'>Error <SortArrow Column="Error" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                    </div>
                    @foreach (var evt in GetSortedEvents(state))
                    {
                        <div class="table-row">
                            <span>@DashboardTime.Event(evt.Timestamp)</span>
                            <span>@evt.SatelliteId</span>
                            <span>@evt.Room</span>
                            <span>@evt.Identity</span>
                            <span>@evt.Metric</span>
                            <span>@(evt.DurationMs is { } d ? $"{d} ms" : "")</span>
                            <span>@evt.Outcome</span>
                            @if (!string.IsNullOrEmpty(evt.Error))
                            {
                                <span class="status-err tooltip-anchor" tabindex="0">ERR
                                    <span class="tooltip-popup">@evt.Error</span>
                                </span>
                            }
                            else
                            {
                                <span></span>
                            }
                        </div>
                    }
                    @if (!state.Events.Any())
                    {
                        <EmptyState Message="No voice events recorded" />
                    }
                </div>
            </section>
        </ChildContent>
    </MetricControls>
</div>

@code {
    // The one family with a choice the shared header does not know about. It is declared where the
    // pill is rendered, for the same reason the other choices are declared where the family is:
    // whoever shows a pill owns the reading and writing behind it.
    private MetricChoice _aggregation = default!;
    private IReadOnlyList<MetricChoice> _extraChoices = [];

    protected override void OnInitialized()
    {
        _aggregation = MetricChoice.For("agg", () => Store.State.Agg, Store.SetAgg);
        _extraChoices = [_aggregation];
    }

    private static readonly IReadOnlyList<PillOption> DimensionOptions =
    [
        new("Satellite", nameof(VoiceDimension.SatelliteId)),
        new("Room", nameof(VoiceDimension.Room)),
        new("Identity", nameof(VoiceDimension.Identity)),
        new("Speaker", nameof(VoiceDimension.Speaker)),
        new("Outcome", nameof(VoiceDimension.Outcome)),
        new("Channel", nameof(VoiceDimension.Channel)),
    ];

    private static readonly IReadOnlyList<PillOption> MetricOptions =
    [
        new("Speech end → audio (ms)", nameof(VoiceMetric.SpeechEndToFirstAudioMs)),
        new("Endpoint tail (ms)", nameof(VoiceMetric.EndpointTailMs)),
        new("Speaker verify (ms)", nameof(VoiceMetric.SpeakerVerifyMs)),
        new("Speaker verify, early (ms)", nameof(VoiceMetric.SpeakerVerifyEarlyMs)),
        new("Agent round trip (ms)", nameof(VoiceMetric.AgentRoundTripMs)),
        new("Reply queue wait (ms)", nameof(VoiceMetric.ReplyQueueWaitMs)),
        new("Utterances", nameof(VoiceMetric.UtteranceTranscribed)),
        new("Wake → audio (ms)", nameof(VoiceMetric.WakeToFirstAudioMs)),
        new("STT latency (ms)", nameof(VoiceMetric.SttLatencyMs)),
        new("TTS latency (ms)", nameof(VoiceMetric.TtsLatencyMs)),
        new("Announcements", nameof(VoiceMetric.AnnouncePlayed)),
        new("STT errors", nameof(VoiceMetric.SttError)),
        new("TSE invoked", nameof(VoiceMetric.TseInvoked)),
        new("TSE skipped", nameof(VoiceMetric.TseSkipped)),
        new("TSE failed", nameof(VoiceMetric.TseFailed)),
        new("TSE latency (ms)", nameof(VoiceMetric.TseLatencyMs)),
    ];

    private static readonly IReadOnlyList<PillOption> AggOptions =
    [
        new("Avg", nameof(Aggregation.Avg)),
        new("P50", nameof(Aggregation.P50)),
        new("P95", nameof(Aggregation.P95)),
        new("Max", nameof(Aggregation.Max)),
    ];

    // WakeToFirstAudioMs starts at mic-open, so its median is inflated by however long the user
    // spoke. SpeechEndToFirstAudioMs is the wait. Wake → audio stays available in the chart's
    // metric selector.
    private static double MedianLatency(VoiceState state)
    {
        var durations = state.Events
            .Where(e => e.Metric == VoiceMetric.SpeechEndToFirstAudioMs && e.DurationMs is not null)
            .Select(e => e.DurationMs!.Value)
            .OrderBy(x => x)
            .ToList();
        return durations.Count > 0 ? durations[durations.Count / 2] : 0;
    }

    // Mirrors the query service: any metric whose name ends in Ms is a duration.
    private static string GetMetricUnit(VoiceState state) =>
        state.Metric.ToString().EndsWith("Ms", StringComparison.Ordinal) ? "ms" : "";

    private string _sortColumn = "Time";
    private bool _sortAsc;

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = false; }
    }

    private IEnumerable<VoiceEvent> GetSortedEvents(VoiceState state)
    {
        var events = state.Events.TakeLast(50).AsEnumerable();
        Func<VoiceEvent, object> keySelector = _sortColumn switch
        {
            "Satellite" => e => e.SatelliteId ?? "",
            "Room" => e => e.Room ?? "",
            "Identity" => e => e.Identity ?? "",
            "Metric" => e => e.Metric,
            "Duration" => e => e.DurationMs ?? 0,
            "Outcome" => e => e.Outcome ?? "",
            "Error" => e => e.Error ?? "",
            _ => e => e.Timestamp
        };
        return _sortAsc ? events.OrderBy(keySelector) : events.OrderByDescending(keySelector);
    }

    private string SortClass(string column) => _sortColumn == column ? "sorted" : "";
}
