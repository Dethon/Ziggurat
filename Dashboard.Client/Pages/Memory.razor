@page "/memory"
@using Dashboard.Client.State.Memory
@using Dashboard.Client.State.Metrics
@using Domain.DTOs.Metrics
@using Domain.DTOs.Metrics.Enums
@using static Dashboard.Client.Components.PillSelector
@implements IDisposable
@using Dashboard.Client.State.Tokens
@inject MetricsStore Metrics
@inject TokensStore Tokens
@inject MetricFamilyTable Families
@inject LocalStorageService Storage

<div class="memory-page">
    <MetricControls TStore="MemoryStore" TState="MemoryState"
                    Title="Memory"
                    Description="What was recalled, extracted, merged and judged for each person."
                    Family="Families.Memory"
                    DimensionOptions="DimensionOptions"
                    MetricOptions="MetricOptions"
                    UnavailableMetrics="UnavailableMetrics">
        <ChildContent Context="state">
            <section class="kpi-row">
                <KpiCard Label="Total Recalls" Value="@_metrics.TotalRecalls.ToString("N0")" Color="var(--accent-blue)" />
                <KpiCard Label="Total Extractions" Value="@_metrics.TotalExtractions.ToString("N0")" Color="var(--accent-green)" />
                <KpiCard Label="Avg Latency" Value="@($"{AvgLatency(state):F0}ms")" Color="var(--accent-yellow)" />
                <KpiCard Label="Memories Stored" Value="@_metrics.MemoriesStored.ToString("N0")" Color="var(--accent-purple)" />
                <KpiCard Label="Merged" Value="@_metrics.MemoriesMerged.ToString("N0")" Color="var(--accent-pink)" />
                <KpiCard Label="Decayed" Value="@_metrics.MemoriesDecayed.ToString("N0")" Color="var(--accent-red)" />
            </section>

            <section class="section">
                <h3>Breakdown</h3>
                <DynamicChart Data="state.Breakdown" ChartType="DynamicChart.ChartMode.HorizontalBar"
                              MetricLabel="@(MetricOptions.FirstOrDefault(o => o.Value == state.Metric.ToString())?.Label ?? "")"
                              Unit="@GetMetricUnit(state)" />
            </section>

            <section class="section">
                <div class="tab-bar" role="tablist" aria-label="Memory events">
                    <button type="button" role="tab" aria-selected="@(_activeTab == "Recall" ? "true" : "false")"
                            class="tab @(_activeTab == "Recall" ? "tab-active" : "")" @onclick='() => SetTab("Recall")'>Recall</button>
                    <button type="button" role="tab" aria-selected="@(_activeTab == "Extraction" ? "true" : "false")"
                            class="tab @(_activeTab == "Extraction" ? "tab-active" : "")" @onclick='() => SetTab("Extraction")'>Extraction</button>
                    <button type="button" role="tab" aria-selected="@(_activeTab == "Dreaming" ? "true" : "false")"
                            class="tab @(_activeTab == "Dreaming" ? "tab-active" : "")" @onclick='() => SetTab("Dreaming")'>Dreaming</button>
                    <button type="button" role="tab" aria-selected="@(_activeTab == "Judgments" ? "true" : "false")"
                            class="tab @(_activeTab == "Judgments" ? "tab-active" : "")" @onclick='() => SetTab("Judgments")'>Judgments</button>
                </div>

                @if (_activeTab == "Recall")
                {
                    <div class="events-table tbl-recall">
                        <div class="table-header">
                            <span class='sortable @SortClass("Time")' @onclick='() => SortBy("Time")'>Time <SortArrow Column="Time" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("User")' @onclick='() => SortBy("User")'>User <SortArrow Column="User" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Duration")' @onclick='() => SortBy("Duration")'>Duration <SortArrow Column="Duration" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Memories")' @onclick='() => SortBy("Memories")'>Memories <SortArrow Column="Memories" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        </div>
                        @foreach (var evt in GetSortedRecalls(state))
                        {
                            <div class="table-row">
                                <span>@DashboardTime.Event(evt.Timestamp)</span>
                                <span>@Person(evt.UserId)</span>
                                <span>@evt.DurationMs ms</span>
                                <span>@evt.MemoryCount</span>
                            </div>
                        }
                        @if (!state.RecallEvents.Any())
                        {
                            <EmptyState Message="No recalls in this range" />
                        }
                    </div>
                }
                else if (_activeTab == "Extraction")
                {
                    <div class="events-table tbl-extraction">
                        <div class="table-header">
                            <span class='sortable @SortClass("Time")' @onclick='() => SortBy("Time")'>Time <SortArrow Column="Time" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("User")' @onclick='() => SortBy("User")'>User <SortArrow Column="User" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Duration")' @onclick='() => SortBy("Duration")'>Duration <SortArrow Column="Duration" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Candidates")' @onclick='() => SortBy("Candidates")'>Candidates <SortArrow Column="Candidates" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Dropped")' @onclick='() => SortBy("Dropped")'>Dropped <SortArrow Column="Dropped" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Stored")' @onclick='() => SortBy("Stored")'>Stored <SortArrow Column="Stored" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Outcome")' @onclick='() => SortBy("Outcome")'>Outcome <SortArrow Column="Outcome" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        </div>
                        @foreach (var evt in GetSortedExtractions(state))
                        {
                            <div class="table-row">
                                <span>@DashboardTime.Event(evt.Timestamp)</span>
                                <span>@Person(evt.UserId)</span>
                                <span>@evt.DurationMs ms</span>
                                <span>@evt.CandidateCount</span>
                                <span class="dropped-count">@evt.DroppedCount</span>
                                <span class="stored-count">@evt.StoredCount</span>
                                <span class="@OutcomeClass(evt.Outcome)">@(evt.Outcome ?? "")</span>
                            </div>
                        }
                        @if (!state.ExtractionEvents.Any())
                        {
                            <EmptyState Message="No extractions in this range" />
                        }
                    </div>
                }
                else if (_activeTab == "Dreaming")
                {
                    <div class="events-table tbl-dreaming">
                        <div class="table-header">
                            <span class='sortable @SortClass("Time")' @onclick='() => SortBy("Time")'>Time <SortArrow Column="Time" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("User")' @onclick='() => SortBy("User")'>User <SortArrow Column="User" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Merged")' @onclick='() => SortBy("Merged")'>Merged <SortArrow Column="Merged" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Refused")' @onclick='() => SortBy("Refused")'>Refused <SortArrow Column="Refused" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Decayed")' @onclick='() => SortBy("Decayed")'>Decayed <SortArrow Column="Decayed" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span>Profile Regen</span>
                            <span>Refused merges</span>
                        </div>
                        @foreach (var evt in GetSortedDreamings(state))
                        {
                            <div class="table-row">
                                <span>@DashboardTime.Event(evt.Timestamp)</span>
                                <span>@Person(evt.UserId)</span>
                                <span class="merged-count">@evt.MergedCount</span>
                                <span class="refused-count">@evt.RefusedCount</span>
                                <span class="decayed-count">@evt.DecayedCount</span>
                                @* The dash stays typed: it is a placeholder for nothing rather
                                   than an icon, and an em dash is exactly what it looks like. *@
                                <span>
                                    @if (evt.ProfileRegenerated)
                                    {
                                        <Icon Glyph="Icons.Check" Class="regenerated-tick" />
                                    }
                                    else
                                    {
                                        @("—")
                                    }
                                </span>
                                <span class="refused-ids">@string.Join(" | ", evt.RefusedMerges.Select(ids => string.Join(", ", ids)))</span>
                            </div>
                        }
                        @if (!state.DreamingEvents.Any())
                        {
                            <EmptyState Message="No dreaming runs in this range" />
                        }
                    </div>
                }
                else
                {
                    <div class="events-table tbl-judgments">
                        <div class="table-header">
                            <span class='sortable @SortClass("Time")' @onclick='() => SortBy("Time")'>Time <SortArrow Column="Time" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("User")' @onclick='() => SortBy("User")'>User <SortArrow Column="User" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span class='sortable @SortClass("Kind")' @onclick='() => SortBy("Kind")'>Kind <SortArrow Column="Kind" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                            <span>Verdict</span>
                            <span>Candidate</span>
                            <span>Scores</span>
                            <span class='sortable @SortClass("Duration")' @onclick='() => SortBy("Duration")'>Latency <SortArrow Column="Duration" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        </div>
                        @foreach (var evt in GetSortedJudgments(state))
                        {
                            <div class="table-row">
                                <span>@DashboardTime.Event(evt.Timestamp)</span>
                                <span>@Person(evt.UserId)</span>
                                <span>@evt.Kind</span>
                                <span class="@Verdict(evt).Css">@Verdict(evt).Text</span>
                                <span class="judgment-candidate" title="@evt.Candidate">@(evt.Candidate ?? "")</span>
                                <span class="judgment-scores">@Scores(evt)</span>
                                <span>@(evt.DurationMs is { } d ? $"{d} ms" : "")</span>
                            </div>
                        }
                        @if (!state.JudgmentEvents.Any())
                        {
                            <EmptyState Message="No judgments recorded" />
                        }
                    </div>
                }
            </section>
        </ChildContent>
    </MetricControls>
</div>

@code {
    private MetricsState _metrics = new();
    private IDisposable? _metricsSub;

    // The tab is the page's own state, not one of the family's choices, so it is not the control
    // header's to remember. Its key is unchanged.
    private string _activeTab = "Recall";

    private static readonly IReadOnlyList<PillOption> DimensionOptions =
    [
        new("User", nameof(MemoryDimension.User)),
        new("Event Type", nameof(MemoryDimension.EventType)),
        new("Agent", nameof(MemoryDimension.Agent)),
        new("Outcome", nameof(MemoryDimension.Outcome)),
    ];

    private static readonly IReadOnlyList<PillOption> MetricOptions =
    [
        new("Count", nameof(MemoryMetric.Count)),
        new("Avg Duration", nameof(MemoryMetric.AvgDuration)),
        new("Stored", nameof(MemoryMetric.StoredCount)),
        new("Merged", nameof(MemoryMetric.MergedCount)),
        new("Decayed", nameof(MemoryMetric.DecayedCount)),
        new("Candidates", nameof(MemoryMetric.CandidateCount)),
        new("Dropped", nameof(MemoryMetric.DroppedCount)),
        new("Refused merges", nameof(MemoryMetric.RefusedMergeCount)),
    ];

    private static readonly IReadOnlySet<string> UserOnlyMetrics =
        MetricFamilyTable.UserOnlyMemoryMetrics.Select(m => m.ToString()).ToHashSet();

    private static readonly IReadOnlySet<string> Nothing = new HashSet<string>();

    private static IReadOnlySet<string> UnavailableMetrics(MemoryState state) =>
        state.GroupBy != MemoryDimension.User ? UserOnlyMetrics : Nothing;

    protected override async Task OnInitializedAsync()
    {
        var savedTab = await Storage.GetStringAsync("memory.activeTab");
        if (!string.IsNullOrEmpty(savedTab)) _activeTab = savedTab;

        _metricsSub = Metrics.StateObservable.Subscribe(m => InvokeAsync(() =>
        {
            _metrics = m;
            StateHasChanged();
        }));
    }

    private async Task SetTab(string tab)
    {
        _activeTab = tab;
        await Storage.SetAsync("memory.activeTab", tab);
    }

    private static double AvgLatency(MemoryState state)
    {
        var totalDuration = state.RecallEvents.Sum(e => e.DurationMs) + state.ExtractionEvents.Sum(e => e.DurationMs);
        var totalOps = state.RecallEvents.Count + state.ExtractionEvents.Count;
        return totalOps > 0 ? (double)totalDuration / totalOps : 0;
    }

    private static string GetMetricUnit(MemoryState state) => state.Metric switch
    {
        MemoryMetric.AvgDuration => "ms",
        _ => ""
    };

    private string _sortColumn = "Time";
    private bool _sortAsc;

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = false; }
    }

    // An account under the name its model calls carried: memory's events name only the account.
    private string Person(string userId) => PeopleOf(Tokens.State.Events).Of(userId, userId);

    private IReadOnlyList<TokenUsageEvent>? _peopleFrom;
    private PersonNames? _people;

    // Built once per list of calls rather than once per row.
    private PersonNames PeopleOf(IReadOnlyList<TokenUsageEvent> calls)
    {
        if (!ReferenceEquals(calls, _peopleFrom) || _people is null)
        {
            _peopleFrom = calls;
            _people = PersonNames.From(calls);
        }

        return _people;
    }

    private IEnumerable<MemoryRecallEvent> GetSortedRecalls(MemoryState state)
    {
        var events = state.RecallEvents.TakeLast(50).AsEnumerable();
        Func<MemoryRecallEvent, object> keySelector = _sortColumn switch
        {
            "User" => e => Person(e.UserId),
            "Duration" => e => e.DurationMs,
            "Memories" => e => e.MemoryCount,
            _ => e => e.Timestamp
        };
        return _sortAsc ? events.OrderBy(keySelector) : events.OrderByDescending(keySelector);
    }

    private IEnumerable<MemoryExtractionEvent> GetSortedExtractions(MemoryState state)
    {
        var events = state.ExtractionEvents.TakeLast(50).AsEnumerable();
        Func<MemoryExtractionEvent, object> keySelector = _sortColumn switch
        {
            "User" => e => Person(e.UserId),
            "Duration" => e => e.DurationMs,
            "Candidates" => e => e.CandidateCount,
            "Dropped" => e => e.DroppedCount,
            "Stored" => e => e.StoredCount,
            "Outcome" => e => e.Outcome ?? "",
            _ => e => e.Timestamp
        };
        return _sortAsc ? events.OrderBy(keySelector) : events.OrderByDescending(keySelector);
    }

    private static string OutcomeClass(string? outcome) => outcome switch
    {
        MemoryExtractionOutcomes.Extracted => "outcome-extracted",
        MemoryExtractionOutcomes.Gated => "outcome-gated",
        MemoryExtractionOutcomes.Failed => "outcome-failed",
        _ => ""
    };

    private IEnumerable<MemoryDreamingEvent> GetSortedDreamings(MemoryState state)
    {
        var events = state.DreamingEvents.TakeLast(50).AsEnumerable();
        Func<MemoryDreamingEvent, object> keySelector = _sortColumn switch
        {
            "User" => e => Person(e.UserId),
            "Merged" => e => e.MergedCount,
            "Refused" => e => e.RefusedCount,
            "Decayed" => e => e.DecayedCount,
            _ => e => e.Timestamp
        };
        return _sortAsc ? events.OrderBy(keySelector) : events.OrderByDescending(keySelector);
    }

    private IEnumerable<MemoryJudgmentEvent> GetSortedJudgments(MemoryState state)
    {
        var events = state.JudgmentEvents.TakeLast(100).AsEnumerable();
        Func<MemoryJudgmentEvent, object> keySelector = _sortColumn switch
        {
            "User" => e => Person(e.UserId),
            "Kind" => e => e.Kind,
            "Duration" => e => e.DurationMs ?? 0,
            _ => e => e.Timestamp
        };
        return _sortAsc ? events.OrderBy(keySelector) : events.OrderByDescending(keySelector);
    }

    // What the judgment decided, in a word: the gate skipped or extracted, the check dropped or
    // kept, the pairs linked this many groups; an absent answer fell back to today's behaviour.
    private static (string Text, string Css) Verdict(MemoryJudgmentEvent evt) => evt switch
    {
        { Answered: false } => ("absent", "verdict-absent"),
        { Kind: MemoryJudgmentKinds.Gate, Skipped: true } => ("gated", "verdict-gated"),
        { Kind: MemoryJudgmentKinds.Gate } => ("extract", "verdict-kept"),
        { Kind: MemoryJudgmentKinds.Verify, Dropped: true } => ("dropped", "verdict-dropped"),
        { Kind: MemoryJudgmentKinds.Verify } => ("kept", "verdict-kept"),
        { Kind: MemoryJudgmentKinds.Pairs } => ($"{evt.Linked?.Count ?? 0} linked of {evt.MemoryIds?.Count ?? 0}", "verdict-kept"),
        _ => ("", "")
    };

    private static string Scores(MemoryJudgmentEvent evt) => evt switch
    {
        { Kind: MemoryJudgmentKinds.Pairs, Relations: { } relations } =>
            string.Join(" ", relations.Select(r => $"{r.Key}:{r.Value}")),
        { Scores: { } scores } => string.Join(" ", scores.Select(s => $"{s.Key}:{s.Value:F2}")),
        _ => ""
    };

    private string SortClass(string column) => _sortColumn == column ? "sorted" : "";

    public void Dispose() => _metricsSub?.Dispose();
}
