@page "/latency"
@using Dashboard.Client.State.Latency
@using Domain.DTOs.Metrics
@using Domain.DTOs.Metrics.Enums
@using static Dashboard.Client.Components.PillSelector
@inject MetricFamilyTable Families

<div class="tokens-page">
    <MetricControls TStore="LatencyStore" TState="LatencyState"
                    Title="Latency"
                    Family="Families.Latency"
                    DimensionOptions="DimensionOptions"
                    MetricOptions="MetricOptions">
        <ChildContent Context="state">
            <section class="kpi-row">
                <KpiCard Label="p50 (all stages)" Value="@($"{Percentile(state, 50):N0} ms")" Color="var(--accent-green)" />
                <KpiCard Label="p95 (all stages)" Value="@($"{Percentile(state, 95):N0} ms")" Color="var(--accent-yellow)" />
                <KpiCard Label="p99 (all stages)" Value="@($"{Percentile(state, 99):N0} ms")" Color="var(--accent-purple)" />
                <KpiCard Label="Slowest stage (p95)" Value="@SlowestStage(state)" Color="var(--accent-blue)" />
            </section>

            <section class="section">
                <DynamicChart Data="state.Breakdown" ChartType="DynamicChart.ChartMode.HorizontalBar"
                              MetricLabel="@MetricLabel(state)"
                              Unit="ms" UseFullLabels="true" />
            </section>

            <section class="section">
                <h3>@MetricLabel(state) trend</h3>
                <LatencyTrendChart Series="state.Trend" />
            </section>

            <section class="section">
                <h3>Recent Turns</h3>
                <div class="events-table">
                    <div class="table-header">
                        <span class='sortable @SortClass("Time")' @onclick='() => SortBy("Time")'>Time <SortArrow Column="Time" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Stage")' @onclick='() => SortBy("Stage")'>Stage <SortArrow Column="Stage" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Model")' @onclick='() => SortBy("Model")'>Model <SortArrow Column="Model" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Duration")' @onclick='() => SortBy("Duration")'>Duration <SortArrow Column="Duration" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Agent")' @onclick='() => SortBy("Agent")'>Agent <SortArrow Column="Agent" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Conversation")' @onclick='() => SortBy("Conversation")'>Conversation <SortArrow Column="Conversation" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                    </div>
                    @foreach (var evt in GetSortedEvents(state))
                    {
                        <div class="table-row">
                            <span>@evt.Timestamp.ToString("dd/MM HH:mm:ss")</span>
                            <span>@evt.Stage</span>
                            <span>@(evt.Model ?? "-")</span>
                            <span>@evt.DurationMs.ToString("N0") ms</span>
                            <span>@(evt.AgentId ?? "-")</span>
                            <span>@(evt.ConversationId ?? "-")</span>
                        </div>
                    }
                </div>
            </section>
        </ChildContent>
    </MetricControls>
</div>

@code {
    private static readonly IReadOnlyList<PillOption> DimensionOptions =
    [
        new("Stage", nameof(LatencyDimension.Stage)),
        new("Agent", nameof(LatencyDimension.Agent)),
        new("Model", nameof(LatencyDimension.Model)),
    ];

    private static readonly IReadOnlyList<PillOption> MetricOptions =
    [
        new("Avg", nameof(Aggregation.Avg)),
        new("P50", nameof(Aggregation.P50)),
        new("P95", nameof(Aggregation.P95)),
        new("P99", nameof(Aggregation.P99)),
    ];

    private static string MetricLabel(LatencyState state) =>
        MetricOptions.FirstOrDefault(o => o.Value == state.Metric.ToString())?.Label ?? "";

    private static decimal Percentile(LatencyState state, int q) =>
        Percentile(state.Events.Select(e => (decimal)e.DurationMs).ToArray(), q);

    private static string SlowestStage(LatencyState state) =>
        state.Events
            .GroupBy(e => e.Stage)
            .Select(g => (Stage: g.Key, P95: Percentile(g.Select(e => (decimal)e.DurationMs).ToArray(), 95)))
            .OrderByDescending(x => x.P95)
            .Select(x => x.Stage.ToString())
            .FirstOrDefault() ?? "-";

    private static decimal Percentile(decimal[] values, int q)
    {
        if (values.Length == 0) return 0m;
        var sorted = values.OrderBy(v => v).ToArray();
        var rank = (int)Math.Ceiling((double)q / 100.0 * sorted.Length);
        return sorted[Math.Clamp(rank - 1, 0, sorted.Length - 1)];
    }

    private string _sortColumn = "Time";
    private bool _sortAsc;

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = false; }
    }

    private IEnumerable<LatencyEvent> GetSortedEvents(LatencyState state)
    {
        var events = state.Events.TakeLast(50).AsEnumerable();
        Func<LatencyEvent, object> keySelector = _sortColumn switch
        {
            "Stage" => e => e.Stage,
            "Model" => e => e.Model ?? "",
            "Duration" => e => e.DurationMs,
            "Agent" => e => e.AgentId ?? "",
            "Conversation" => e => e.ConversationId ?? "",
            _ => e => e.Timestamp
        };
        return _sortAsc ? events.OrderBy(keySelector) : events.OrderByDescending(keySelector);
    }

    private string SortClass(string column) => _sortColumn == column ? "sorted" : "";
}

<style>
    .tokens-page { display: flex; flex-direction: column; gap: 1.5rem; }
    .kpi-row { display: flex; gap: 1rem; flex-wrap: wrap; }
    .section h3 { font-size: 1rem; margin-bottom: 0.8rem; color: var(--text-secondary); }
    .events-table { display: flex; flex-direction: column; gap: 2px; }
    .table-header, .table-row { display: grid; grid-template-columns: 135px minmax(0, 1fr) minmax(0, 1fr) 120px minmax(0, 1fr) minmax(0, 1fr); gap: 0.5rem; padding: 0.4rem 0.8rem; font-size: 0.82rem; }
    .table-header { background: var(--bg-secondary); color: var(--text-secondary); font-weight: 600; border-radius: 4px; text-transform: uppercase; font-size: 0.7rem; }
    .table-row { background: var(--bg-card); border-radius: 4px; }
    .table-row:hover { background: rgba(255,255,255,0.03); }

    @@media (max-width: 768px) {
        .events-table { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .table-header, .table-row { grid-template-columns: 110px minmax(0, 1fr) minmax(0, 1fr) 90px minmax(0, 1fr) minmax(0, 1fr); font-size: 0.72rem; padding: 0.4rem 0.5rem; min-width: 660px; }
        .table-row span { word-break: break-word; }
    }
</style>
