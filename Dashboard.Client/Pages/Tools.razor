@page "/tools"
@using Dashboard.Client.State.Tools
@using Domain.DTOs.Metrics
@using Domain.DTOs.Metrics.Enums
@using static Dashboard.Client.Components.PillSelector
@inject MetricFamilyTable Families

<div class="tools-page">
    <MetricControls TStore="ToolsStore" TState="ToolsState"
                    Title="Tool Calls"
                    Family="Families.Tools"
                    DimensionOptions="DimensionOptions"
                    MetricOptions="MetricOptions"
                    UnavailableMetrics="UnavailableMetrics">
        <ChildContent Context="state">
            <section class="kpi-row">
                <KpiCard Label="Total Calls" Value="@state.Events.Count.ToString("N0")" Color="var(--accent-yellow)" />
                <KpiCard Label="Success Rate" Value="@($"{SuccessRate(state):F1}%")" Color="var(--accent-green)" />
                <KpiCard Label="Avg Duration" Value="@($"{AvgDuration(state):F0}ms")" Color="var(--accent-blue)" />
            </section>

            <section class="section">
                <h3>Breakdown</h3>
                <DynamicChart Data="state.Breakdown" ChartType="DynamicChart.ChartMode.HorizontalBar"
                              MetricLabel="@(MetricOptions.FirstOrDefault(o => o.Value == state.Metric.ToString())?.Label ?? "")"
                              Unit="@GetMetricUnit(state)" />
            </section>

            <section class="section">
                <h3>Recent calls</h3>
                <div class="events-table tbl-tools">
                    <div class="table-header">
                        <span class='sortable @SortClass("Time")' @onclick='() => SortBy("Time")'>Time <SortArrow Column="Time" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Tool")' @onclick='() => SortBy("Tool")'>Tool <SortArrow Column="Tool" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Duration")' @onclick='() => SortBy("Duration")'>Duration <SortArrow Column="Duration" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                        <span class='sortable @SortClass("Status")' @onclick='() => SortBy("Status")'>Status <SortArrow Column="Status" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></span>
                    </div>
                    @foreach (var evt in GetSortedEvents(state))
                    {
                        <div class="table-row">
                            <span>@DashboardTime.Event(evt.Timestamp)</span>
                            <span class="mono" title="@evt.ToolName">@ShortToolName(evt.ToolName)</span>
                            <span>@evt.DurationMs.ToString("N0") ms</span>
                            @if (evt.Success)
                            {
                                <span class="status-ok">OK</span>
                            }
                            else
                            {
                                <span class="status-err tooltip-anchor" tabindex="0">FAIL
                                    @if (!string.IsNullOrEmpty(evt.Error))
                                    {
                                        <span class="tooltip-popup">@evt.Error</span>
                                    }
                                </span>
                            }
                        </div>
                    }
                </div>
            </section>
        </ChildContent>
    </MetricControls>
</div>

@code {
    private static readonly IReadOnlyList<PillOption> DimensionOptions =
    [
        new("Tool Name", nameof(ToolDimension.ToolName)),
        new("Status", nameof(ToolDimension.Status)),
    ];

    private static readonly IReadOnlyList<PillOption> MetricOptions =
    [
        new("Call Count", nameof(ToolMetric.CallCount)),
        new("Avg Duration", nameof(ToolMetric.AvgDuration)),
        new("Error Rate", nameof(ToolMetric.ErrorRate)),
    ];

    private static readonly IReadOnlySet<string> ErrorRateOnly = new HashSet<string> { nameof(ToolMetric.ErrorRate) };
    private static readonly IReadOnlySet<string> Nothing = new HashSet<string>();

    private static IReadOnlySet<string> UnavailableMetrics(ToolsState state) =>
        state.GroupBy == ToolDimension.Status ? ErrorRateOnly : Nothing;

    private static double SuccessRate(ToolsState state) =>
        state.Events.Count > 0 ? state.Events.Count(e => e.Success) * 100.0 / state.Events.Count : 0;

    private static double AvgDuration(ToolsState state) =>
        state.Events.Count > 0 ? state.Events.Average(e => e.DurationMs) : 0;

    private static string GetMetricUnit(ToolsState state) => state.Metric switch
    {
        ToolMetric.AvgDuration => "ms",
        ToolMetric.ErrorRate => "%",
        _ => ""
    };

    private static string ShortToolName(string name)
    {
        var idx = name.LastIndexOf("__", StringComparison.Ordinal);
        return idx >= 0 ? name[(idx + 2)..] : name;
    }

    private string _sortColumn = "Time";
    private bool _sortAsc;

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = false; }
    }

    private IEnumerable<ToolCallEvent> GetSortedEvents(ToolsState state)
    {
        var events = state.Events.TakeLast(50).AsEnumerable();
        Func<ToolCallEvent, object> keySelector = _sortColumn switch
        {
            "Tool" => e => e.ToolName,
            "Duration" => e => e.DurationMs,
            "Status" => e => e.Success,
            _ => e => e.Timestamp
        };
        return _sortAsc ? events.OrderBy(keySelector) : events.OrderByDescending(keySelector);
    }

    private string SortClass(string column) => _sortColumn == column ? "sorted" : "";
}
