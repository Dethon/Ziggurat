@page "/errors"
@using Dashboard.Client.State.Errors
@using Domain.DTOs.Metrics
@using Domain.DTOs.Metrics.Enums
@using static Dashboard.Client.Components.PillSelector
@inject MetricFamilyTable Families
@inject HouseholdDirectory Directory

<div class="errors-page">
    <MetricControls TStore="ErrorsStore" TState="ErrorsState"
                    Title="Errors"
                    Description="Failures reported by every service and household server."
                    Family="Families.Errors"
                    DimensionOptions="DimensionOptions">
        <ChildContent Context="state">
            <section class="kpi-row">
                <KpiCard Label="Total Errors" Value="@state.Events.Count.ToString("N0")" Color="var(--accent-red)" />
                <KpiCard Label="Services Affected" Value="@state.Events.Select(e => e.Service).Distinct().Count().ToString()" Color="var(--accent-yellow)" />
            </section>

            <section class="section">
                <h3>Breakdown</h3>
                <DynamicChart Data="state.Breakdown.AsChartData()" ChartType="DynamicChart.ChartMode.HorizontalBar"
                              MetricLabel="Error Count" />
            </section>

            <section class="section">
                <h3>Recent errors</h3>
                <div class="events-table tbl-errors">
                    <div class="table-header">
                        <button type="button" class='sortable @SortClass("Time")' @onclick='() => SortBy("Time")'>Time <SortArrow Column="Time" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></button>
                        <button type="button" class='sortable @SortClass("Service")' @onclick='() => SortBy("Service")'>Service <SortArrow Column="Service" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></button>
                        <button type="button" class='sortable @SortClass("Type")' @onclick='() => SortBy("Type")'>Type <SortArrow Column="Type" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></button>
                        <button type="button" class='sortable @SortClass("Message")' @onclick='() => SortBy("Message")'>Message <SortArrow Column="Message" SortColumn="@_sortColumn" Ascending="@_sortAsc" /></button>
                    </div>
                    @foreach (var evt in GetSortedEvents(state))
                    {
                        <div class="table-row">
                            <span>@DashboardTime.Event(evt.Timestamp)</span>
                            <span class="tone-yellow" title="@evt.Service">@_names.ServiceLabel(evt.Service)</span>
                            <span class="tone-red tooltip-anchor" tabindex="0">
                                @ShortName(evt.ErrorType)
                                <span class="tooltip-popup">@evt.ErrorType</span>
                            </span>
                            <span class="tooltip-anchor" tabindex="0">
                                @evt.Message
                                <span class="tooltip-popup">@evt.Message</span>
                            </span>
                        </div>
                    }
                    @if (!state.Events.Any())
                    {
                        <EmptyState Message="No errors recorded" />
                    }
                </div>
            </section>
        </ChildContent>
    </MetricControls>
</div>

@code {
    private HouseholdNames _names = new([], Answered: false);

    protected override async Task OnInitializedAsync() => _names = await Directory.NamesAsync();

    private static readonly IReadOnlyList<PillOption> DimensionOptions =
    [
        new("Service", nameof(ErrorDimension.Service)),
        new("Error Type", nameof(ErrorDimension.ErrorType)),
    ];

    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : string.Concat(s.AsSpan(0, max), "...");

    private static string ShortName(string name)
    {
        var idx = name.LastIndexOf(':');
        return idx >= 0 ? name[(idx + 1)..] : name;
    }

    private string _sortColumn = "Time";
    private bool _sortAsc;

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = false; }
    }

    private IEnumerable<ErrorEvent> GetSortedEvents(ErrorsState state)
    {
        var events = state.Events.TakeLast(100).AsEnumerable();
        Func<ErrorEvent, object> keySelector = _sortColumn switch
        {
            "Service" => e => e.Service,
            "Type" => e => e.ErrorType,
            "Message" => e => e.Message,
            _ => e => e.Timestamp
        };
        return _sortAsc ? events.OrderBy(keySelector) : events.OrderByDescending(keySelector);
    }

    private string SortClass(string column) => _sortColumn == column ? "sorted" : "";
}
