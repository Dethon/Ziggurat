@page "/"
@using Dashboard.Client.State.Errors
@using Dashboard.Client.State.Health
@using Dashboard.Client.State.Metrics
@using Dashboard.Client.State.Schedules
@using Dashboard.Client.State.Tokens
@using Dashboard.Client.State.Tools
@using Dashboard.Client.State.Voice
@using Domain.DTOs.Metrics.Enums
@using System.Globalization
@implements IDisposable
@inject MetricsStore Metrics
@inject HealthStore Health
@inject TokensStore Tokens
@inject ToolsStore Tools
@inject ErrorsStore Errors
@inject SchedulesStore Schedules
@inject VoiceStore Voice
@inject MetricFamilyTable Families
@inject DataLoadEffect DataLoad
@inject LocalStorageService Storage

<div class="overview-page">
    <header class="page-header">
        <div class="page-title">
            <h2>Overview</h2>
            <p class="page-description">Spend, tool use and service health across the deployment.</p>
        </div>
        <PillSelector Label="Time" Options="TimeWindows.Options" Value="@_selectedDays.ToString()"
                      OnChanged="OnTimeChanged" />
    </header>

    <section class="kpi-row">
        <KpiCard Label="Input Tokens" Value="@_metrics.InputTokens.ToString("N0")" Color="var(--accent-blue)" />
        <KpiCard Label="Output Tokens" Value="@_metrics.OutputTokens.ToString("N0")" Color="var(--accent-purple)" />
        <KpiCard Label="Cost" Value="@($"${_metrics.Cost:F2}")" Color="var(--accent-green)" />
        <KpiCard Label="Tool Calls" Value="@_metrics.ToolCalls.ToString("N0")" Color="var(--accent-yellow)" />
        <KpiCard Label="Errors" Value="@_metrics.ToolErrors.ToString("N0")" Color="var(--accent-red)" />
        <KpiCard Label="Utterances" Value="@_voiceUtterances.ToString("N0")" Color="var(--accent-blue)" />
        <KpiCard Label="Median voice latency" Value="@($"{_voiceLatency:N0} ms")" Color="var(--accent-yellow)" />
    </section>

    <section class="section">
        <h3>
            Service health
            @if (_health.Services.Any())
            {
                var down = _health.Services.Count(s => !s.IsHealthy);
                <span class="health-summary">
                    @(_health.Services.Count - down) of @_health.Services.Count up@(down > 0 ? " · " : "")
                    @if (down > 0)
                    {
                        <span class="tone-red">@down down</span>
                    }
                </span>
            }
        </h3>
        <HealthGrid Services="_health.Services" />
    </section>

    <section class="section">
        <h3>Recent activity <span class="section-count">@_recentActivity.Count.ToString("N0")</span></h3>
        <div class="activity-feed">
            @foreach (var item in _recentActivity)
            {
                <div class="activity-item">
                    <span class="activity-badge @item.Type">@item.TypeLabel</span>
                    <span class="activity-text tooltip-anchor" tabindex="0">
                        @item.Description
                        <span class="tooltip-popup">@item.Description</span>
                    </span>
                    <span class="activity-time">@FormatTime(item.Timestamp)</span>
                </div>
            }
            @if (!_recentActivity.Any())
            {
                <EmptyState Message="No recent activity" />
            }
        </div>
    </section>
</div>

@code {
    private MetricsState _metrics = new();
    private HealthState _health = new();
    private int _selectedDays = 1;
    private List<ActivityItem> _recentActivity = [];
    private long _voiceUtterances;
    private double _voiceLatency;
    private readonly List<IDisposable> _subscriptions = [];

    protected override async Task OnInitializedAsync()
    {
        var savedDays = await Storage.GetIntAsync("overview.days");
        if (savedDays is > 0) _selectedDays = savedDays.Value;

        _subscriptions.Add(Metrics.StateObservable.Subscribe(s => InvokeAsync(() => { _metrics = s; StateHasChanged(); })));
        _subscriptions.Add(Health.StateObservable.Subscribe(s => InvokeAsync(() => { _health = s; StateHasChanged(); })));

        _subscriptions.Add(Tokens.StateObservable.Subscribe(_ => InvokeAsync(() => { RebuildActivity(); StateHasChanged(); })));
        _subscriptions.Add(Tools.StateObservable.Subscribe(_ => InvokeAsync(() => { RebuildActivity(); StateHasChanged(); })));
        _subscriptions.Add(Errors.StateObservable.Subscribe(_ => InvokeAsync(() => { RebuildActivity(); StateHasChanged(); })));
        _subscriptions.Add(Schedules.StateObservable.Subscribe(_ => InvokeAsync(() => { RebuildActivity(); StateHasChanged(); })));

        _subscriptions.Add(Voice.StateObservable.Subscribe(s => InvokeAsync(() =>
        {
            _voiceUtterances = s.Events.Count(e => e.Metric == VoiceMetric.UtteranceTranscribed);
            var lat = s.Events.Where(e => e.Metric == VoiceMetric.WakeToFirstAudioMs && e.DurationMs is not null)
                              .Select(e => e.DurationMs!.Value).OrderBy(x => x).ToList();
            _voiceLatency = lat.Count > 0 ? lat[lat.Count / 2] : 0;
            StateHasChanged();
        })));

        await DataLoad.LoadAsync(_selectedDays, Families.OverviewFamilies);
    }

    private async Task OnTimeChanged(string value)
    {
        _selectedDays = int.Parse(value, CultureInfo.InvariantCulture);
        await Storage.SetAsync("overview.days", value);
        await DataLoad.LoadAsync(_selectedDays, Families.OverviewFamilies);
    }

    private void RebuildActivity()
    {
        var items = new List<ActivityItem>();

        // A memory call or a judgment names only the account; shown under the name the person's turns carried.
        var people = PersonNames.From(Tokens.State.Events);
        items.AddRange(Tokens.State.Events.Select(e =>
            new ActivityItem("token", "Token", $"{people.Of(e.UserId, e.Sender)} used {e.InputTokens + e.OutputTokens:N0} tokens ({e.Model})", e.Timestamp)));

        items.AddRange(Tools.State.Events.Select(e =>
            new ActivityItem(e.Success ? "tool" : "error", "Tool", $"{e.ToolName} — {e.DurationMs}ms{(e.Success ? "" : " FAILED")}", e.Timestamp)));

        items.AddRange(Errors.State.Events.Select(e =>
            new ActivityItem("error", "Error", $"[{e.Service}] {e.ErrorType}: {e.Message}", e.Timestamp)));

        items.AddRange(Schedules.State.Events.Select(e =>
            new ActivityItem(e.Success ? "schedule" : "error", "Schedule", $"{e.ScheduleId}{(e.Success ? "" : " FAILED")}", e.Timestamp)));

        _recentActivity = items.OrderByDescending(i => i.Timestamp).Take(500).ToList();
    }

    private static string FormatTime(DateTimeOffset ts) => DashboardTime.Event(ts);

    public void Dispose() => _subscriptions.ForEach(s => s.Dispose());

    private record ActivityItem(string Type, string TypeLabel, string Description, DateTimeOffset Timestamp);
}
