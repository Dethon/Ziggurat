@* A headline figure. Its colour marks the family it belongs to with a small swatch rather than
   painting the number, so a row of seven stays calm and the figures read as figures. *@
<div class="kpi-card" style="--kpi-color: @Color;">
    <div class="kpi-label"><span class="kpi-swatch" aria-hidden="true"></span>@Label</div>
    <div class="kpi-value">@Value</div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string Color { get; set; } = "var(--accent-blue)";
}
