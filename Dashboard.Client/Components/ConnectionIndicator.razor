@using Dashboard.Client.State.Connection
@implements IDisposable
@inject ConnectionStore Connection

@* The one connection badge, in the top bar of every page; the overview reads the same store. *@
<div class="connection-status @_status.Modifier" title="Connection: @_status.Label">
    <span class="live-dot"></span>
    <span class="live-label">@_status.Label</span>
</div>

@code {
    private ConnectionStatus _status = ConnectionStatus.Connecting;
    private IDisposable? _subscription;

    protected override void OnInitialized()
    {
        _subscription = Connection.StateObservable.Subscribe(state =>
        {
            InvokeAsync(() =>
            {
                _status = state.Status;
                StateHasChanged();
            });
        });
    }

    public void Dispose() => _subscription?.Dispose();
}
