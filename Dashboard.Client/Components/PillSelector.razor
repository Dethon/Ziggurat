@* A choice among a few short options is a segmented control, every option in sight; a long list
   (Voice's sixteen metrics) is a dropdown, which a row of pills could only show by running off the
   page or wrapping into a wall of buttons. *@
<div class="pill-selector">
    <span class="pill-label" id="@_labelId">@Label</span>
    @if (AsDropdown)
    {
        <span class="select-wrap">
            <select aria-labelledby="@_labelId" value="@Value" @onchange="e => SelectValue(e.Value as string ?? Value)">
                @foreach (var option in Options)
                {
                    <option value="@option.Value" selected="@(option.Value == Value)"
                            disabled="@DisabledValues.Contains(option.Value)">@option.Label</option>
                }
            </select>
            <Icon Glyph="Icons.ChevronDown" Class="select-chevron" />
        </span>
    }
    else
    {
        <div class="pill-group" role="group" aria-labelledby="@_labelId">
            @foreach (var option in Options)
            {
                var isActive = option.Value == Value;
                var isDisabled = DisabledValues.Contains(option.Value);
                <button type="button" class="pill @(isActive ? "active" : "") @(isDisabled ? "disabled" : "")"
                        aria-pressed="@(isActive ? "true" : "false")"
                        disabled="@isDisabled"
                        @onclick="() => SelectValue(option.Value)">
                    @option.Label
                </button>
            }
        </div>
    }
</div>

@code {
    // Past these, a segmented control no longer fits a phone's width.
    private const int MostPills = 5;
    private const int MostPillCharacters = 40;

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<PillOption> Options { get; set; } = [];
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> OnChanged { get; set; }
    [Parameter] public IReadOnlySet<string> DisabledValues { get; set; } = new HashSet<string>();

    private readonly string _labelId = $"pill-{Guid.NewGuid():N}";

    private bool AsDropdown =>
        Options.Count > MostPills || Options.Sum(o => o.Label.Length) > MostPillCharacters;

    private async Task SelectValue(string value)
    {
        if (value != Value)
            await OnChanged.InvokeAsync(value);
    }

    public record PillOption(string Label, string Value);
}
