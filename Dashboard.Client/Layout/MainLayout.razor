@inherits LayoutComponentBase
@inject MetricsLiveConnection LiveConnection

<div class="layout">
    <nav class="sidebar">
        @* Every one of these was a font glyph, six of them trailing a text-presentation variation
           selector to talk the platform out of drawing them as emoji, which is the whole argument
           for not typing an icon. The voice speaker below was already drawn; the rest match it. *@
        <NavLink href="/" Match="NavLinkMatch.All" class="sidebar-icon" title="Overview">
            <Icon Glyph="Icons.Dashboard" Size="1.1em" />
        </NavLink>
        <NavLink href="/tokens" class="sidebar-icon" title="Tokens">
            <Icon Glyph="Icons.Currency" Size="1.1em" />
        </NavLink>
        <NavLink href="/tools" class="sidebar-icon" title="Tools">
            <Icon Glyph="Icons.Gear" Size="1.1em" />
        </NavLink>
        <NavLink href="/memory" class="sidebar-icon" title="Memory">
            <Icon Glyph="Icons.Chip" Size="1.1em" />
        </NavLink>
        <NavLink href="/errors" class="sidebar-icon" title="Errors">
            <Icon Glyph="Icons.Warning" Size="1.1em" />
        </NavLink>
        <NavLink href="/schedules" class="sidebar-icon" title="Schedules">
            <Icon Glyph="Icons.Calendar" Size="1.1em" />
        </NavLink>
        @* A stopwatch rather than the calendar above it: schedules are when work fires, latency is
           how long it took, and two clock faces would have read as the same page twice. *@
        <NavLink href="/latency" class="sidebar-icon" title="Latency">
            <Icon Glyph="Icons.Stopwatch" Size="1.1em" />
        </NavLink>
        <NavLink href="/voice" class="sidebar-icon" title="Voice">
            <Icon Glyph="Icons.Speaker" Size="1.1em" />
        </NavLink>
        <ConnectionIndicator />
    </nav>
    <main class="content">
        @Body
    </main>
</div>

@code {
    // Nothing to catch: the live connection keeps trying until it is live.
    protected override Task OnInitializedAsync() => LiveConnection.ConnectAsync();
}
