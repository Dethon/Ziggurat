# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src

COPY ["Domain/Domain.csproj", "Domain/"]
COPY ["Infrastructure/Infrastructure.csproj", "Infrastructure/"]
COPY ["Mcp.Hosting/Mcp.Hosting.csproj", "Mcp.Hosting/"]
RUN dotnet restore "Infrastructure/Infrastructure.csproj" \
    && dotnet restore "Mcp.Hosting/Mcp.Hosting.csproj"

COPY ["Domain/", "Domain/"]
COPY ["Infrastructure/", "Infrastructure/"]
COPY ["Mcp.Hosting/", "Mcp.Hosting/"]
ARG BUILD_CONFIGURATION=Release
# Every channel server publishes with BuildProjectReferences=false, so the projects they reference
# have to be built here. Mcp.Hosting references Domain and the MCP server package only — it must
# never gain Infrastructure, or the channel server that depends on Domain alone (ServiceBus)
# inherits Infrastructure's whole stack without ever asking for it. Telegram asked: it dictates,
# and the shared transcription client lives in Infrastructure.
RUN dotnet build "Infrastructure/Infrastructure.csproj" -c $BUILD_CONFIGURATION --no-restore \
    && dotnet build "Mcp.Hosting/Mcp.Hosting.csproj" -c $BUILD_CONFIGURATION --no-restore
