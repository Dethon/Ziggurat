{
  // Three independent Rust crates, no workspace and no Cargo.toml at the root — so rust-analyzer
  // discovers several projects and cannot pick one ("more than one project"). Naming each is what
  // makes it load each on its own terms instead. The VS Code equivalent is in
  // `.vscode/settings.json`; keep the two lists in step.
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": ["satellite/Cargo.toml", "speech-typist/Cargo.toml", "sandbox-runtime/Cargo.toml"]
      }
    }
  }
}
