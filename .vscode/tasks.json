{
    "version": "2.0.0",
    "options": {
        "env": {
            "DC": "docker compose -f DockerCompose/docker-compose.yml -f DockerCompose/docker-compose.override.linux.yml -f DockerCompose/docker-compose.override.debug.yml -f DockerCompose/docker-compose.override.ports.yml -f DockerCompose/docker-compose.override.no-dri.yml -p jackbot",
            "SERVICES": "agent webui observability mcp-idealista mcp-channel-signalr mcp-channel-telegram mcp-scheduling mcp-timers lemonade redis",
            "DC_LOCAL": "docker compose -f DockerCompose/docker-compose.yml -f DockerCompose/docker-compose.override.linux.yml -f DockerCompose/docker-compose.override.ports.yml -p jackbot",
            "LOCAL_DEPS": "redis",
            "KIT_LOCAL": "docker compose -f TenantKit/docker-compose.yml -f TenantKit/docker-compose.override.ports.yml",
            "KIT_DEPS": "qbittorrent jackett camoufox homeassistant",
            "DEPLOYMENT_HOST": "localhost",
            "KIT_REDIS_PASSWORD": "local-redis-password",
            "REDIS_PASSWORD": "local-redis-password"
        }
    },
    "tasks": [
        {
            "label": "docker-debug-up",
            "type": "shell",
            "command": "docker volume inspect jackbot_vsdbg > /dev/null 2>&1 || $DC run --rm vsdbg-install && $DC build base-sdk && $DC up -d --build $SERVICES && until docker exec agent ls /remote_debugger/vsdbg > /dev/null 2>&1; do sleep 1; done",
            "problemMatcher": []
        },
        {
            "label": "local-deps",
            "type": "shell",
            "command": "$DC_LOCAL up -d --build $LOCAL_DEPS && $KIT_LOCAL up -d --build $KIT_DEPS",
            "problemMatcher": []
        },
        {
            "label": "build-all-local",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Ziggurat.sln",
                "-c",
                "Debug"
            ],
            "dependsOn": "local-deps",
            "problemMatcher": "$msCompile"
        }
    ]
}
