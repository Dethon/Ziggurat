<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
  </ItemGroup>

  <!-- The stores it moves data in, through their own code: Redis's through Infrastructure, and
       Sugary's log through the server's own context, so the rows given away are the ones its query
       filters then show. -->
  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\McpServerSugary\McpServerSugary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

  <!-- The home household's agents and features as the deployment ran them (Steps/HomeConfiguration).
       Embedded rather than copied: the run has no appsettings.json of its own, and a file copied to
       its output would be one more beside the Sugary server's. -->
  <ItemGroup>
    <EmbeddedResource Include="Home/*.json" LogicalName="HouseholdMigration.Home.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
