@code {
    [Parameter] public AgentCatalogEntry? SelectedAgent { get; set; }
    [Parameter] public string? RemovedAgentName { get; set; }
    [Parameter] public EventCallback<string> OnSuggestionClicked { get; set; }
}

<div class="empty-state">
    <div class="empty-state-icon">
        <Icon Glyph="Icons.ChatBubble" />
    </div>
    @if (SelectedAgent is not null)
    {
        @if (RemovedAgentName is not null)
        {
            <p class="empty-state-notice" role="status">@RemovedAgentName was removed from the household: your conversations with it are no longer shown, and what you write now goes to @SelectedAgent.Name.</p>
        }
        <h2>Chat with @SelectedAgent.Name</h2>
        <p>Start a new conversation. Your chat will be saved automatically.</p>
        <SuggestionChips OnSuggestionClicked="OnSuggestionClicked"/>
    }
    else
    {
        <h2>Welcome</h2>
        <p>Select an agent from the sidebar to begin chatting.</p>
    }
</div>
