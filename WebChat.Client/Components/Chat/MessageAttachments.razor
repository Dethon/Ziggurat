@using Domain.DTOs.Channel
@inject IAttachmentService AttachmentService
@inject IJSRuntime Js
@inject TimeProvider Clock
@inject ImageViewer Viewer

@code {
    [Parameter] public IReadOnlyList<AttachmentReference>? Attachments { get; set; }

    private AttachmentPreviewCache _previews = null!;
    private IReadOnlyList<ShownAttachment> _shown = [];

    protected override void OnInitialized() => _previews = new AttachmentPreviewCache(Clock);

    // A thumbnail or a clip needs a URL the browser can fetch, and a download URL is minted rather
    // than published — so each asks for one as it renders, and other kinds only ask when clicked.
    // The cache says which need asking: never held, or held on a ticket that ran out while the
    // app sat in the background.
    protected override Task OnParametersSetAsync()
    {
        _shown = AttachmentDisplay.For(Attachments);
        return RefreshPreviewsAsync();
    }

    private async Task RefreshPreviewsAsync()
    {
        var stale = _previews.Stale(AttachmentDisplay.Previewed(_shown));
        foreach (var attachmentId in stale)
        {
            var download = await AttachmentService.CreateDownloadAsync(attachmentId);
            if (download is { IsLive: true, Value: not null })
            {
                _previews.Hold(attachmentId, download.Value);
                StateHasChanged();
            }
        }
    }

    // The ticket can be gone before its time — a server restart while the app was in the
    // background prunes every one it held — and the image or clip failing to load is the only
    // signal.
    private async Task PreviewFailed(string attachmentId)
    {
        if (_previews.Failed(attachmentId))
        {
            await RefreshPreviewsAsync();
        }
    }

    private async Task Download(AttachmentReference attachment)
    {
        var download = await AttachmentService.CreateDownloadAsync(attachment.Id);
        if (download is { IsLive: true, Value: not null })
        {
            await Js.InvokeVoidAsync("attachments.open", download.Value.Url, attachment.FileName);
        }
    }

    // A tap opens the picture in place, among its message's other pictures; keeping it is the menu's.
    private void View(AttachmentReference attachment)
    {
        _menuFor = null;
        var pictures = _shown.Where(s => s.Shape == AttachmentShape.Thumbnail).Select(s => s.Reference).ToList();
        Viewer.Open(
            [.. pictures.Select(p => new ViewedPicture(p.Id, p.FileName, _previews.TryGetUrl(p.Id, out var url) ? url : null))],
            pictures.FindIndex(p => p.Id == attachment.Id));
    }

    // The thumbnail's own menu: a right click, or a long press where the browser makes one of it.
    private string? _menuFor;

    private void OpenMenu(AttachmentReference attachment) => _menuFor = attachment.Id;

    private async Task DownloadFromMenu(AttachmentReference attachment)
    {
        _menuFor = null;
        await Download(attachment);
    }

    private static string DescribeSize(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / (1024.0 * 1024.0):0.#} MB"
            : $"{Math.Max(1, bytes / 1024)} KB";
}

@if (_shown.Count > 0)
{
    <div class="message-attachments">
        @foreach (var (attachment, shape) in _shown)
        {
            @if (shape == AttachmentShape.Thumbnail && _previews.TryGetUrl(attachment.Id, out var preview))
            {
                <span class="attachment-item">
                    <button class="attachment-thumbnail"
                            title="@attachment.FileName"
                            aria-label="@($"View {attachment.FileName}")"
                            aria-haspopup="dialog"
                            @onclick="() => View(attachment)"
                            @oncontextmenu="() => OpenMenu(attachment)"
                            @oncontextmenu:preventDefault="true">
                        <img src="@preview"
                             alt="@attachment.FileName"
                             @onload="() => _previews.Loaded(attachment.Id)"
                             @onerror="() => PreviewFailed(attachment.Id)" />
                    </button>
                    @if (_menuFor == attachment.Id)
                    {
                        <span class="attachment-menu-backdrop" @onclick="() => _menuFor = null"
                              @oncontextmenu="() => _menuFor = null" @oncontextmenu:preventDefault="true"></span>
                        <span class="attachment-menu" role="menu">
                            <button role="menuitem" class="message-action" @onclick="() => View(attachment)">
                                <Icon Glyph="Icons.Expand" Size="14" />
                                View
                            </button>
                            <button role="menuitem" class="message-action" @onclick="() => DownloadFromMenu(attachment)">
                                <Icon Glyph="Icons.Download" Size="14" />
                                Download
                            </button>
                        </span>
                    }
                </span>
            }
            else if (shape == AttachmentShape.Clip && _previews.TryGetUrl(attachment.Id, out var clip))
            {
                @* Ranged requests on the same ticket play and seek it; a clip that cannot be fetched
                   shows as a chip, as one never copied here does. *@
                <video class="attachment-clip"
                       src="@clip"
                       title="@attachment.FileName"
                       controls
                       playsinline
                       preload="metadata"
                       @onloadedmetadata="() => _previews.Loaded(attachment.Id)"
                       @onerror="() => PreviewFailed(attachment.Id)"></video>
            }
            else
            {
                <button class="attachment-chip"
                        title="@attachment.FileName"
                        @onclick="() => Download(attachment)">
                    <span class="attachment-name">@attachment.FileName</span>
                    <span class="attachment-size">@DescribeSize(attachment.SizeBytes)</span>
                </button>
            }
        }
    </div>
}
