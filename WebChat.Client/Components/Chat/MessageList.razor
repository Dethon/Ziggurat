@using WebChat.Client.Helpers
@inherits StoreSubscriberComponent

@inject MessagesStore MessagesStore
@inject TopicsStore TopicsStore
@inject StreamingStore StreamingStore
@inject UserIdentityStore UserIdentityStore
@inject IDispatcher Dispatcher
@inject IJSRuntime Js
@inject RenderCoordinator RenderCoordinator

@code {
    private IReadOnlyList<ChatMessageModel> _messages = [];
    private string? _topicId;
    private bool _isStreaming;
    private AgentCatalogEntry? _selectedAgent;
    private string? _removedAgentName;
    private StoredTopic? _topic;
    private string? _carriedReasoning;
    private string? _carriedToolCalls;
    private ElementReference _messagesArea;
    private string? _currentUserId;
    private IDisposable? _streamingContentSubscription;
    private bool _forceScrollToBottom;

    protected override void OnInitialized()
    {
        // Subscribe to selected topic ID
        Subscribe(TopicsStore.StateObservable,
            state => state.SelectedTopicId,
            id =>
            {
                _topicId = id;
                _forceScrollToBottom = true; // Scroll to bottom when switching topics
                UpdateMessages();
                UpdateStreamingStatus();
                UpdateStreamingContentSubscription();
            });

        // The open topic, for who started it
        Subscribe(TopicsStore.StateObservable,
            state => state.Topics.FirstOrDefault(t => t.TopicId == state.SelectedTopicId),
            topic => _topic = topic);

        // Subscribe to selected agent
        Subscribe(TopicsStore.StateObservable,
            state => state.Agents.FirstOrDefault(a => a.Id == state.SelectedAgentId),
            agent => _selectedAgent = agent);

        Subscribe(TopicsStore.StateObservable,
            state => state.RemovedAgentName,
            removed => _removedAgentName = removed);

        // Subscribe to messages for current topic
        Subscribe(MessagesStore.StateObservable,
            state => state,
            _ => UpdateMessages());

        // Subscribe to streaming status and content for auto-scroll
        Subscribe(StreamingStore.StateObservable,
            state => state.StreamingTopics,
            _ =>
            {
                UpdateStreamingStatus();
                UpdateStreamingContentSubscription();
            });

        // Subscribe to the signed-in person, whose messages are drawn as this page's own
        Subscribe(UserIdentityStore.StateObservable,
            state => state.SignedIn?.UserId,
            userId => _currentUserId = userId);
    }

    private void UpdateMessages()
    {
        var raw = _topicId != null
            ? MessagesStore.State.MessagesByTopic.GetValueOrDefault(_topicId, [])
            : [];
        var merged = MergeConsecutiveAssistantMessages(raw);

        if (_isStreaming && merged.Count > 0
            && merged[^1] is { Role: "assistant", Content: "" or null } last
            && (last.Reasoning is not null || last.ToolCalls is not null))
        {
            _carriedReasoning = last.Reasoning;
            _carriedToolCalls = last.ToolCalls;
            _messages = merged.Take(merged.Count - 1).ToList();
        }
        else
        {
            _carriedReasoning = null;
            _carriedToolCalls = null;
            _messages = merged;
        }
    }

    // Merges consecutive assistant messages into a single bubble.
    // Reasoning concatenated with "\n-----\n", tool calls with "\n".
    // Content taken from whichever message has it. Empty trailing bubble kept (expecting more data).
    internal static IReadOnlyList<ChatMessageModel> MergeConsecutiveAssistantMessages(
        IReadOnlyList<ChatMessageModel> messages)
    {
        if (messages.Count <= 1)
        {
            return messages;
        }

        var result = new List<ChatMessageModel>(messages.Count);
        string? accReasoning = null;
        string? accToolCalls = null;
        string? accContent = null;
        MessageVersions? accVersions = null;
        ChatMessageModel? anchor = null;

        for (var i = 0; i < messages.Count; i++)
        {
            var message = messages[i];

            if (message.Role != "assistant" || message.NoReply)
            {
                Flush(result, ref anchor, ref accContent, ref accReasoning, ref accToolCalls, ref accVersions);
                result.Add(message);
                continue;
            }

            if (!string.IsNullOrEmpty(message.Content))
            {
                if (accContent is not null)
                {
                    // Previous message(s) already had content — flush them as a separate bubble
                    Flush(result, ref anchor, ref accContent, ref accReasoning, ref accToolCalls, ref accVersions);
                }

                accContent = message.Content;
            }

            accVersions ??= message.Versions;
            accReasoning = MessageFieldMerger.Merge(
                accReasoning, message.Reasoning, MessageFieldMerger.ReasoningSeparator);
            accToolCalls = MessageFieldMerger.Merge(
                accToolCalls, message.ToolCalls, MessageFieldMerger.ToolCallsSeparator);

            // Prefer the message that carries content as anchor for MessageId/Timestamp
            anchor = anchor is null || !string.IsNullOrEmpty(message.Content) ? message : anchor;

            var nextIsAssistant = i < messages.Count - 1 && messages[i + 1].Role == "assistant";
            if (!nextIsAssistant)
            {
                Flush(result, ref anchor, ref accContent, ref accReasoning, ref accToolCalls, ref accVersions);
            }
        }

        Flush(result, ref anchor, ref accContent, ref accReasoning, ref accToolCalls, ref accVersions);
        return result;

        static void Flush(
            List<ChatMessageModel> result,
            ref ChatMessageModel? anchor,
            ref string? content,
            ref string? reasoning,
            ref string? toolCalls,
            ref MessageVersions? versions)
        {
            if (anchor is null)
            {
                return;
            }

            result.Add(anchor with
            {
                Content = content ?? "",
                Reasoning = reasoning,
                ToolCalls = toolCalls,
                Versions = versions ?? anchor.Versions
            });

            anchor = null;
            content = null;
            reasoning = null;
            toolCalls = null;
            versions = null;
        }
    }

    private void UpdateStreamingStatus()
    {
        var wasStreaming = _isStreaming;
        _isStreaming = _topicId != null && StreamingStore.State.StreamingTopics.Contains(_topicId);

        if (wasStreaming && !_isStreaming)
        {
            _isRetrying = false;
            UpdateMessages();
        }
    }

    private void UpdateStreamingContentSubscription()
    {
        // Dispose existing subscription
        _streamingContentSubscription?.Dispose();
        _streamingContentSubscription = null;

        // Subscribe to streaming content if topic is streaming (triggers re-render for auto-scroll)
        if (_isStreaming && !string.IsNullOrEmpty(_topicId))
        {
            _streamingContentSubscription = RenderCoordinator
                .CreateStreamingObservable(_topicId)
                .Subscribe(OnStreamingContentChanged);
        }
    }

    private void OnStreamingContentChanged(StreamingContent? _)
    {
        InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        _streamingContentSubscription?.Dispose();
        try
        {
            ((IJSInProcessRuntime)Js).InvokeVoid("chatScroll.dispose");
        }
        catch
        {
            // JS runtime may not be available during dispose
        }
        base.Dispose();
    }

    private void HandleSuggestionClicked(string suggestion)
    {
        Dispatcher.Dispatch(new SendMessage(_topicId, suggestion));
    }

    private bool _isRetrying;

    private void HandleRetry()
    {
        if (_topicId is not null && !_isRetrying)
        {
            _isRetrying = true;
            Dispatcher.Dispatch(new RetryLastMessage(_topicId));
        }
    }

    // The message being edited in place of its bubble, by entry id: a reload that keeps it keeps the
    // edit open, one that drops it closes it.
    private string? _editingEntryId;

    private void HandleEditInPlace(ChatMessageModel message, string text)
    {
        _editingEntryId = null;
        if (_topicId is not null && message.EntryId is not null)
        {
            Dispatcher.Dispatch(new EditMessageInPlace(_topicId, message.EntryId, text));
        }
    }

    private void HandleEditAndRerun(ChatMessageModel message, string text)
    {
        _editingEntryId = null;
        if (_topicId is not null && message.EntryId is not null)
        {
            Dispatcher.Dispatch(new EditAndRerun(_topicId, message.EntryId, text));
        }
    }

    private bool MayRewrite => !_isStreaming && _topic?.MayRewrite(_currentUserId) == true;

    private IReadOnlyList<MessageActionKind> ActionsFor(ChatMessageModel message, int index) =>
        MessageActionsLogic.For(message, new MessageActionContext(
            _isStreaming, _topic?.MayRewrite(_currentUserId) == true,
            IsLastReply: index == _messages.Count - 1 && AnswersAPerson(index)));

    // The reply at an index answers a person's own message, which a reroll may send again: not a turn a
    // service started (a fire, a login), which acted for whoever its delegation named.
    private bool AnswersAPerson(int index) =>
        _messages.Take(index).LastOrDefault(m => m.Role == "user") is { } asked && ServiceNotice.Of(asked) is null;

    // The models the topic's agent may be run on, a reroll's choice.
    private IReadOnlyList<PatchableModel> RerollModels =>
        TopicsStore.State.Agents.FirstOrDefault(a => a.Id == _topic?.AgentId)?.PatchableModels ?? [];

    private string? AgentModel =>
        TopicsStore.State.Agents.FirstOrDefault(a => a.Id == _topic?.AgentId)?.DefaultModel;

    private void Reroll(string? model)
    {
        if (_topicId is not null)
        {
            Dispatcher.Dispatch(new RerollLastReply(
                _topicId, model is null ? null : new AgentConfigPatch { Model = model }));
        }
    }

    private void HandleSwitchVersion(MessageVersions versions, int index)
    {
        if (_topicId is not null)
        {
            Dispatcher.Dispatch(new SwitchMessageVersion(_topicId, versions.Slot, index));
        }
    }

    private void HandleAction(ChatMessageModel message, MessageActionChoice choice)
    {
        if (_topicId is null || message.EntryId is null)
        {
            return;
        }

        switch (choice.Kind)
        {
            case MessageActionKind.Reroll:
            case MessageActionKind.RerollWith:
                Reroll(choice.Model);
                break;
            case MessageActionKind.Edit:
                _editingEntryId = message.EntryId;
                break;
            case MessageActionKind.Delete:
                Dispatcher.Dispatch(new DeleteMessagesFrom(_topicId, message.EntryId));
                break;
        }
    }

    private bool ShouldShowAvatar(int index)
    {
        if (index == 0)
        {
            return true;
        }

        var current = _messages[index];
        var previous = _messages[index - 1];

        // Show avatar if sender OR role changed
        return current.SenderId != previous.SenderId
            || current.Role != previous.Role;
    }

    private bool IsOwnMessage(ChatMessageModel message)
    {
        return message.Role == "user"
            && !string.IsNullOrEmpty(message.SenderId)
            && message.SenderId == _currentUserId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("chatScroll.initStickyScroll", _messagesArea);
            await Js.InvokeVoidAsync("chatScroll.scrollToBottom", _messagesArea, false);
        }
        else if (_forceScrollToBottom)
        {
            _forceScrollToBottom = false;
            await Js.InvokeVoidAsync("chatScroll.scrollToBottom", _messagesArea, false);
        }
        else
        {
            // Sticky scroll: only scroll if user hasn't scrolled away
            await Js.InvokeVoidAsync("chatScroll.scrollToBottomIfSticky", _messagesArea);
        }
    }
}

<div class="messages-area" @ref="_messagesArea">
    @if (_messages.Count == 0 && !_isStreaming)
    {
        <EmptyState SelectedAgent="_selectedAgent" RemovedAgentName="@_removedAgentName" OnSuggestionClicked="HandleSuggestionClicked"/>
    }
    else
    {
        @foreach (var (message, index) in _messages.Select((m, i) => (m, i)))
        {
            if (ServiceNotice.Of(message) is { } line)
            {
                <ServiceNoticeLine Message="@message" Line="@line" />
                continue;
            }

            if (message is { NoReply: true, Versions: { } slotVersions })
            {
                // A reply streaming in is the answer this line stood for.
                if (!_isStreaming)
                {
                    <div class="no-reply-line">
                        <span>No reply</span>
                        <VersionSwitcher Versions="@slotVersions" Enabled="@MayRewrite"
                                         OnSwitch="@(index => HandleSwitchVersion(slotVersions, index))" />
                        @if (MayRewrite && index == _messages.Count - 1 && AnswersAPerson(index))
                        {
                            <button class="btn-retry" @onclick="@(() => Reroll(null))">
                                <Icon Glyph="Icons.Retry" Size="14" />
                                Answer again
                            </button>
                        }
                    </div>
                }

                continue;
            }

            if (_editingEntryId is not null && message.EntryId == _editingEntryId)
            {
                <MessageEditor Text="@message.Content"
                               Tools="@MessageActionsLogic.ToolsFrom(_messages, index)"
                               AllowSave="true"
                               AllowRerun="@(message.Role == "user")"
                               OnSave="@(text => HandleEditInPlace(message, text))"
                               OnRerun="@(text => HandleEditAndRerun(message, text))"
                               OnCancel="@(() => _editingEntryId = null)" />
                continue;
            }

            <ChatMessage Message="@message"
                         ShowAvatar="@ShouldShowAvatar(index)"
                         IsOwnMessage="@IsOwnMessage(message)"
                         ShowRetry="@(message.IsError && index == _messages.Count - 1 && !_isStreaming)"
                         OnRetry="@HandleRetry"
                         Actions="@ActionsFor(message, index)"
                         RerollModels="@RerollModels"
                         AgentModel="@AgentModel"
                         MaySwitchVersions="@MayRewrite"
                         OnSwitchVersion="@(index => HandleSwitchVersion(message.Versions!, index))"
                         OnAction="@(action => HandleAction(message, action))"
                         TopicOwnerId="@_topic?.OwnerId"
                         TopicOwnerName="@_topic?.OwnerName" />
        }

        @if (_isStreaming && !string.IsNullOrEmpty(_topicId))
        {
            <StreamingMessageDisplay TopicId="@_topicId"
                                     CarriedReasoning="@_carriedReasoning"
                                     CarriedToolCalls="@_carriedToolCalls"/>
        }
    }
</div>
