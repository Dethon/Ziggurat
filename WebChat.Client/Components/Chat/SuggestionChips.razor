@code {
    [Parameter] public EventCallback<string> OnSuggestionClicked { get; set; }

    private async Task HandleClick(string message)
    {
        await OnSuggestionClicked.InvokeAsync(message);
    }

}

<div class="suggestion-chips">
    <button class="suggestion-chip" @onclick="@(() => HandleClick("What are your capabilities?"))">
        <span class="chip-icon">✨</span>
        <span>Capabilities</span>
    </button>
</div>
