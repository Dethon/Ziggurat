@using ConnStatus = WebChat.Client.State.Connection.ConnectionStatus
@inherits StoreSubscriberComponent

@inject IJSRuntime Js
@inject IDispatcher Dispatcher
@inject TopicsStore TopicsStore
@inject StreamingStore StreamingStore
@inject ConnectionStore ConnectionStore
@inject ComposerStore ComposerStore
@inject AgentSettingsStore AgentSettingsStore
@inject DictationEffect Dictation

@code {
    // One control for every platform: the phone offers photo library, camera and file browsing
    // from it, and the installed app behaves exactly as the browser tab does. What it offers comes
    // from the server's own list once that has arrived — a picker offering a kind the server
    // would refuse is a picker promising something it cannot deliver.
    private const string DefaultAcceptedKinds = "image/png,image/jpeg,image/gif,image/webp,application/pdf";

    private string _inputText = "";
    private ElementReference _textareaRef;
    private ElementReference _composerRef;
    private string? _topicId;
    private string? _selectedAgentId;
    private bool _isStreaming;
    private bool _isConnected;
    private bool _disabled;
    private bool _draggingOver;
    private IReadOnlyList<ComposerAttachment> _attachments = [];
    private string? _capabilityRefusal;
    private ElementReference _micRef;
    private DictationState _dictation = new();
    private long _lastTranscriptStamp;

    protected override void OnInitialized()
    {
        Subscribe(TopicsStore.StateObservable, state => (state.SelectedTopicId, state.SelectedAgentId), tuple =>
        {
            _topicId = tuple.SelectedTopicId;
            _selectedAgentId = tuple.SelectedAgentId;
            UpdateDisabledState();
            UpdateStreamingStatus();
            UpdateAttachments();
        });

        Subscribe(StreamingStore.StateObservable, state => state.StreamingTopics, _ =>
        {
            UpdateStreamingStatus();
        });

        Subscribe(ConnectionStore.StateObservable, state => state.Status, status =>
        {
            _isConnected = status == ConnStatus.Connected;
            UpdateDisabledState();
        });

        Subscribe(ComposerStore.StateObservable, state => state.AttachmentsByTopic, _ => UpdateAttachments());

        Subscribe(ComposerStore.StateObservable, state => state.Limits, _ => StateHasChanged());

        // The words land in the composer, never in a message: the person is always the one who
        // presses send. A transcript carries a stamp, so the same sentence dictated twice arrives
        // twice instead of being taken for the one already in the box.
        Subscribe(ComposerStore.StateObservable, state => state.Dictation, dictation =>
        {
            _dictation = dictation;
            if (dictation.Transcript is { } transcript && transcript.Stamp != _lastTranscriptStamp)
            {
                _lastTranscriptStamp = transcript.Stamp;
                _inputText = ComposerSelectors.Append(_inputText, transcript.Text);
            }

            StateHasChanged();
        });

        // Switching model is the fix for a capability refusal, so the refusal has to follow it.
        Subscribe(AgentSettingsStore.StateObservable, state => state.ByAgent, _ => UpdateAttachments());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("chatInput.bindFileDrops", _composerRef);
            // The microphone element is always in the markup, only hidden when the control is
            // Send, so the browser registers against it once and never loses its listeners to a
            // keystroke.
            await Dictation.RegisterAsync(_micRef);
        }
    }

    private void UpdateStreamingStatus()
    {
        _isStreaming = _topicId is not null && StreamingStore.State.StreamingTopics.Contains(_topicId);
    }

    private void UpdateDisabledState()
    {
        _disabled = string.IsNullOrEmpty(_selectedAgentId) || !_isConnected;
    }

    private void UpdateAttachments()
    {
        _attachments = ComposerStore.State.For(_topicId);
        _capabilityRefusal = _selectedAgentId is null
            ? null
            : ComposerSelectors.CapabilityRefusal(
                AgentSettingsStore.State, TopicsStore.State.Agents, _selectedAgentId, _attachments);
    }

    private string AcceptedKinds =>
        ComposerStore.State.Limits is { AllowedMediaTypes.Count: > 0 } limits
            ? string.Join(",", limits.AllowedMediaTypes)
            : DefaultAcceptedKinds;

    private int ReadyCount => _attachments.Count(a => a.Status == AttachmentStatus.Ready);

    // A transcript in flight is the composer being busy in exactly the sense an upload already
    // was: the half-message it was meant to complete must not be able to go out without it.
    private bool UploadInFlight =>
        ComposerSelectors.HasUploadInFlight(_attachments)
        || _dictation.Status == DictationStatus.Transcribing;

    private bool CanSend => ChatInputLogic.CanSend(
        _disabled, _inputText, _isStreaming, ReadyCount, UploadInFlight, _capabilityRefusal);

    private SendControl Control =>
        ComposerSelectors.SendControl(_isStreaming, _inputText, ReadyCount, _dictation.Status);

    private string? Refusal => _capabilityRefusal ?? _dictation.Refusal;

    private void StopDictating() => Dispatcher.Dispatch(new StopDictation());

    private void DiscardDictation() => Dispatcher.Dispatch(new DiscardDictation());

    private void HandleFilesPicked(InputFileChangeEventArgs e)
    {
        var picked = e.GetMultipleFiles(maximumFileCount: 50)
            .Select(file => new PickedFile(
                file.Name,
                string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                file.Size,
                // The cap is the browser's read limit rather than a rule of this feature; the
                // effect refuses an oversized file before it ever opens the stream.
                ct => Task.FromResult(file.OpenReadStream(long.MaxValue, ct))))
            .ToList();

        if (picked.Count > 0)
        {
            Dispatcher.Dispatch(new AttachFiles(_topicId, picked));
        }
    }

    private void RemoveAttachment(ComposerAttachment attachment)
    {
        if (_topicId is not null)
        {
            Dispatcher.Dispatch(new RemoveAttachment(_topicId, attachment.LocalId));
        }
    }

    private async Task HandleSubmit()
    {
        if (!CanSend)
        {
            return;
        }

        var message = _inputText;
        _inputText = "";

        // Reset textarea height after clearing text
        await Js.InvokeVoidAsync("chatInput.reset", _textareaRef);

        Dispatcher.Dispatch(new SendMessage(_topicId, message));
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", ShiftKey: false })
        {
            await HandleSubmit();
        }
    }

    private void HandleCancel()
    {
        if (_topicId is not null)
        {
            Dispatcher.Dispatch(new CancelStreaming(_topicId));
        }
    }

    private void HandleDragEnter() => _draggingOver = true;

    private void HandleDragLeave() => _draggingOver = false;
}

<div class="input-container @(_draggingOver ? "dragging" : "")"
     @ref="_composerRef"
     @ondragenter="HandleDragEnter"
     @ondragleave="HandleDragLeave"
     @ondrop="HandleDragLeave">

    @if (Refusal is not null)
    {
        <div class="composer-refusal" role="alert">@Refusal</div>
    }

    @if (_dictation.Hint is not null)
    {
        <div class="composer-hint">@_dictation.Hint</div>
    }

    @if (_attachments.Count > 0)
    {
        <div class="composer-attachments">
            @foreach (var attachment in _attachments)
            {
                <div class="composer-attachment @attachment.Status.ToString().ToLowerInvariant()">
                    <span class="attachment-name">@attachment.FileName</span>
                    @if (attachment.Status == AttachmentStatus.Uploading)
                    {
                        <progress class="attachment-progress" max="100" value="@attachment.PercentComplete"></progress>
                    }
                    @if (attachment.Status == AttachmentStatus.Failed)
                    {
                        <span class="attachment-error">@attachment.Error</span>
                    }
                    <button class="attachment-remove"
                            title="@(attachment.Status == AttachmentStatus.Uploading ? "Cancel" : "Remove")"
                            @onclick="() => RemoveAttachment(attachment)">
                        <Icon Glyph="Icons.Close" Size="14" />
                    </button>
                </div>
            }
        </div>
    }

    <div class="input-wrapper">
        @* The strip takes the textarea's place while the microphone is open. The clock, the level
           meter and the travel of the discard hint are written straight to the DOM by the browser:
           a per-frame trip through the WASM heap would buy nothing and cost the frame. *@
        @if (_dictation.IsRecording)
        {
            <div class="dictation-strip" data-testid="dictation-strip">
                <span class="dictation-pulse" aria-hidden="true"></span>
                <span class="dictation-timer" data-testid="dictation-timer">0:00</span>
                <span class="dictation-level" aria-hidden="true"></span>
                @if (_dictation.Status == DictationStatus.Latched)
                {
                    <button class="dictation-trash"
                            title="Throw this recording away"
                            data-testid="dictation-trash"
                            @onclick="DiscardDictation">
                        <Icon Glyph="Icons.Trash" Size="18" />
                    </button>
                    @* A paper plane, asked for as the shape everyone already reads as "on it goes",
                       though what goes on is the words into the box: this button never sends. The
                       same drawing as Send, which is the one it hands the words to. *@
                    <button class="dictation-stop"
                            title="Finish and put the words in the box"
                            data-testid="dictation-stop"
                            @onclick="StopDictating">
                        <Icon Glyph="Icons.PaperPlane" Size="18" Class="composer-icon" />
                    </button>
                }
                else
                {
                    <span class="dictation-slide" data-testid="dictation-slide">‹ slide to cancel</span>
                }
            </div>
        }
        else
        {
            @* A drawn clip rather than the "+" the platform renders in whatever font it likes: at
               the size of this row that character is neither the weight nor the colour of the
               shapes beside it. Held at an angle, as a clip on a page would be, so it reads as an
               object and not as a glyph.

               The clip and the paper plane are Font Awesome Free 6 outlines (CC BY 4.0). Both are
               drawn to the edge of their own viewBox, where the Material shapes beside them fill
               about three quarters of theirs, so the box is padded here rather than the icon shrunk:
               the drawing then comes out the size of the trash can and the microphone next to it. *@
            <label class="btn btn-secondary attach-button" title="Attach a file">
                <InputFile class="attach-input"
                           OnChange="HandleFilesPicked"
                           multiple
                           accept="@AcceptedKinds"
                           disabled="@_disabled" />
                <Icon Glyph="Icons.Paperclip" Size="18" Class="composer-icon" />
            </label>

            <textarea @ref="_textareaRef"
                      class="chat-input"
                      placeholder="Type your message..."
                      @bind="_inputText"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      disabled="@_disabled"
                      rows="1"></textarea>
        }
    </div>

    @* One control in this spot, always the one the person is about to use: Cancel while the reply
       runs, the microphone where Send would have nothing to send. The microphone stays in the
       markup either way — hidden rather than removed — so the browser registers against it once
       and does not lose its listeners to a keystroke. *@
    @if (Control == SendControl.Cancel)
    {
        <button class="btn btn-secondary cancel-button"
                data-testid="composer-cancel"
                title="Stop the reply"
                aria-label="Stop the reply"
                @onclick="HandleCancel">
            @* A filled square reads heavier than an outline of the same width, so this one is drawn
               a little under the size of the plane it stands in for. *@
            <Icon Glyph="Icons.Square" Size="18" Class="composer-icon" />
        </button>
    }
    <button class="btn btn-primary send-button @(Control == SendControl.Send ? "" : "control-hidden")"
            data-testid="composer-send"
            title="Send"
            aria-label="Send"
            @onclick="HandleSubmit"
            disabled="@(!CanSend)">
        <Icon Glyph="Icons.PaperPlane" Size="18" Class="composer-icon" />
    </button>
    @* The slot rather than the button carries the hidden class: the microphone keeps its place in
       the render tree, and the slot is what the way-up hint is measured against. *@
    <div class="mic-slot @(Control == SendControl.Microphone ? "" : "control-hidden")">
        @* Sliding up to latch is the one gesture with nothing on screen to announce it. It appears
           under the finger that could make it, rises with the travel already made, and is gone the
           moment there is nothing left to say. *@
        @if (_dictation.Status == DictationStatus.Recording)
        {
            <div class="dictation-lift" data-testid="dictation-lift" aria-hidden="true">
                <Icon Glyph="Icons.ChevronUp" Size="16" Class="lift-arrow" />
                <Icon Glyph="Icons.Lock" Size="14" Class="lift-lock" />
            </div>
        }
        @* Drawn rather than an emoji: the platform's font decides what an emoji looks like, and the
           shape it picks is neither the colour nor the weight of the icons beside it. *@
        <button type="button"
                class="btn btn-secondary dictation-mic"
                @ref="_micRef"
                data-testid="dictation-mic"
                title="Hold to dictate"
                disabled="@(_disabled || _dictation.Unavailable || _dictation.Status == DictationStatus.Transcribing)">
            <Icon Glyph="Icons.Microphone" Size="20" Class="dictation-mic-icon" />
        </button>
    </div>
</div>
