@* Puts a saved key to its provider again from what is stored: the page sends no key. A plain button
   inside its key's form, so it never submits the form's fields. *@
<button type="button" class="admin-secondary admin-key-check" disabled="@Disabled" @onclick="OnCheck">@Label</button>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public bool Disabled { get; set; }

    [Parameter, EditorRequired] public EventCallback OnCheck { get; set; }
}
