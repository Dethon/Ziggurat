@using WebChat.Client.State.AgentSettings
@using WebChat.Client.Helpers
@using Microsoft.JSInterop
@inherits StoreSubscriberComponent
@inject TopicsStore TopicsStore
@inject AgentSettingsStore SettingsStore
@inject IDispatcher Dispatcher
@inject IJSRuntime Js

@if (SelectedAgent is { PatchableModels.Count: > 0 } agent)
{
    @* A patch exists only while the selection differs from the agent's defaults, so the trigger
       labels itself in exactly the case where a persisted override would otherwise be invisible. *@
    var patch = OverrideFor(agent);

    <div class="agent-config @(_open ? "open" : "")" @ref="_root">
        <button class="agent-config-trigger @(patch is null ? "" : "overridden")"
                @onclick="Toggle" @onclick:stopPropagation="true"
                aria-haspopup="dialog" aria-expanded="@_open"
                title="@TriggerTitle(agent)">
            <Icon Glyph="Icons.Gear" Size="16" Class="agent-config-gear" />
            @if (patch is not null)
            {
                <span class="agent-config-summary">@SummaryFor(agent, patch)</span>
            }
        </button>

        @if (_open)
        {
            <div class="agent-config-menu" role="dialog" aria-label="Agent model and reasoning effort">
                @* A listbox rather than a native select, on the agent combo's pattern beside it: a
                   native option cannot hold an icon, and an entry here may need one. *@
                <div class="agent-config-row">
                    <span class="agent-config-label" id="agent-config-model-label">Model</span>
                    <div class="agent-config-combo @(_modelOpen ? "open" : "")">
                        <button type="button" class="agent-config-combo-trigger"
                                @onclick="ToggleModels" @onclick:stopPropagation="true"
                                @onkeydown="OnModelKeyDown"
                                aria-haspopup="listbox" aria-expanded="@_modelOpen"
                                aria-labelledby="agent-config-model-label">
                            <span class="agent-config-combo-name">@(ModelNameFor(agent, CurrentModel(agent)) ?? "default")</span>
                            <Icon Glyph="Icons.CaretDown" Size="12" Class="agent-config-combo-caret" />
                        </button>
                        @if (_modelOpen)
                        {
                            <div class="agent-config-combo-menu" role="listbox" aria-labelledby="agent-config-model-label">
                                @foreach (var model in agent.PatchableModels!)
                                {
                                    var selected = string.Equals(model.Id, CurrentModel(agent), StringComparison.OrdinalIgnoreCase);
                                    <button type="button" class="agent-config-item @(selected ? "on" : "")"
                                            role="option" aria-selected="@selected"
                                            @onclick="() => SetModel(agent, model.Id)" @onclick:stopPropagation="true"
                                            @onkeydown="OnModelKeyDown">
                                        <span class="agent-config-item-name">@model.Name</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
                <label class="agent-config-row">
                    <span class="agent-config-label">Reasoning effort</span>
                    <select class="agent-config-select"
                            value="@CurrentEffort(agent)" @onchange="e => SetEffort(agent, e)">
                        @foreach (var effort in agent.PatchableReasoningEfforts ?? AgentConfigPatch.SupportedEfforts)
                        {
                            <option value="@effort">@effort</option>
                        }
                    </select>
                </label>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<AgentCatalogEntry> _agents = [];
    private string? _selectedAgentId;
    private AgentSettingsState _settings = AgentSettingsState.Initial;
    private bool _open;
    private bool _modelOpen;
    private ElementReference _root;
    private OutsidePressWatcher? _watcher;

    private OutsidePressWatcher Watcher => _watcher ??= new OutsidePressWatcher(Js, () =>
    {
        _open = false;
        _modelOpen = false;
        StateHasChanged();
    });

    private AgentCatalogEntry? SelectedAgent =>
        _agents.FirstOrDefault(a => a.Id == _selectedAgentId);

    protected override void OnInitialized()
    {
        Subscribe(TopicsStore.StateObservable, s => s.Agents, a => _agents = a);
        Subscribe(TopicsStore.StateObservable, s => s.SelectedAgentId, id => _selectedAgentId = id);
        Subscribe(SettingsStore.StateObservable, s => s, s => _settings = s);
    }

    private void Toggle()
    {
        _open = !_open;
        _modelOpen = false;
    }

    private void ToggleModels() => _modelOpen = !_modelOpen;

    // Escape shuts the list and nothing else: the dialog around it stays where it was.
    private void OnModelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _modelOpen = false;
        }
    }

    // This menu deliberately stays open after a pick, so the press that finally dismisses it is
    // the one a person makes on their way somewhere else — it has to reach that somewhere.
    protected override Task OnAfterRenderAsync(bool firstRender) => Watcher.SyncAsync(_open, _root);

    public override void Dispose()
    {
        _watcher?.Dispose();
        base.Dispose();
    }

    private AgentConfigPatch? OverrideFor(AgentCatalogEntry agent) =>
        AgentSettingsSelectors.GetConfigPatch(_settings, _agents, agent.Id);

    private string SummaryFor(AgentCatalogEntry agent, AgentConfigPatch patch) =>
        string.Join(" · ", new[] { ModelNameFor(agent, patch.Model), patch.ReasoningEffort }
            .Where(value => !string.IsNullOrWhiteSpace(value)));

    private string TriggerTitle(AgentCatalogEntry agent) =>
        $"Model: {ModelNameFor(agent, CurrentModel(agent)) ?? "default"} · " +
        $"Reasoning effort: {CurrentEffort(agent) ?? "default"}";

    private static string? ModelNameFor(AgentCatalogEntry agent, string? modelId) =>
        modelId is null
            ? null
            : agent.PatchableModels?.FirstOrDefault(m => m.Id == modelId)?.Name ?? modelId;

    private string? CurrentModel(AgentCatalogEntry agent) =>
        _settings.ByAgent.GetValueOrDefault(agent.Id)?.Model ?? agent.DefaultModel;

    private string? CurrentEffort(AgentCatalogEntry agent) =>
        _settings.ByAgent.GetValueOrDefault(agent.Id)?.ReasoningEffort ?? agent.DefaultReasoningEffort;

    private void SetModel(AgentCatalogEntry agent, string modelId)
    {
        _modelOpen = false;
        Dispatcher.Dispatch(new SetAgentModel(agent.Id, modelId));
    }

    private void SetEffort(AgentCatalogEntry agent, ChangeEventArgs e) =>
        Dispatcher.Dispatch(new SetAgentReasoningEffort(agent.Id, e.Value?.ToString()));
}
