@using WebChat.Client.Helpers
@using WebChat.Client.Components.Chat
@inject UserIdentityStore UserIdentityStore
@inject IJSRuntime Js

@code {
    [Parameter] public ChatMessageModel Message { get; set; } = new();
    [Parameter] public bool IsStreaming { get; set; }
    [Parameter] public bool ShowAvatar { get; set; }
    [Parameter] public bool IsOwnMessage { get; set; }
    [Parameter] public bool ShowRetry { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    // What the bubble's menu offers (MessageActionsLogic), and who is told when one is chosen.
    [Parameter] public IReadOnlyList<MessageActionKind> Actions { get; set; } = [];
    [Parameter] public EventCallback<MessageActionChoice> OnAction { get; set; }
    [Parameter] public IReadOnlyList<PatchableModel> RerollModels { get; set; } = [];

    // The model the agent runs on by default: a reply written by another says which.
    [Parameter] public string? AgentModel { get; set; }

    // Whether this person may flip the bubble's versions, and who is told the version chosen.
    [Parameter] public bool MaySwitchVersions { get; set; }
    [Parameter] public EventCallback<int> OnSwitchVersion { get; set; }

    // The topic's owner, by the name stamped when it began: who a message is drawn as when the reader
    // is somebody else.
    [Parameter] public string? TopicOwnerId { get; set; }
    [Parameter] public string? TopicOwnerName { get; set; }

    // The turn this row starts on the rail (TurnRail), which finds the turn on the page by it.
    [Parameter] public int? TurnIndex { get; set; }

    private bool _copied;

    private async Task CopyMessage()
    {
        var text = Message.Content;
        await Js.InvokeVoidAsync("clipboardHelper.copy", text);
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }

    private static string RenderMarkdown(string? content) => ChatMarkdown.ToHtml(content);

    private (string? AvatarUrl, string DisplayName) GetSenderInfo() =>
        SenderLabel.Of(Message.SenderId, UserIdentityStore.State.SignedIn, TopicOwnerId, TopicOwnerName, Message.SenderName);

    private string GetMessageClass()
    {
        var classes = new List<string> { "chat-message", Message.Role };
        if (Message.IsError)
        {
            classes.Add("error");
        }
        // Add cursor class when actively streaming with content
        if (IsStreaming && !string.IsNullOrEmpty(Message.Content))
        {
            classes.Add("streaming-cursor");
        }
        // Add own message class for user's messages
        if (IsOwnMessage)
        {
            classes.Add("own");
        }

        return string.Join(" ", classes);
    }

    private string GetMessageWrapperClass()
    {
        var classes = new List<string>
        {
            "message-wrapper",
            Message.Role == "assistant" ? "agent" : "user"
        };
        return string.Join(" ", classes);
    }

    private string? GetTooltipText()
    {
        return Message.Role == "user" ? GetSenderInfo().DisplayName : null;
    }

    private string? GetFormattedTimestamp()
    {
        if (Message.Timestamp is null)
        {
            return null;
        }

        var local = Message.Timestamp.Value.ToLocalTime();
        var now = DateTimeOffset.Now;

        // If today, show only time
        if (local.Date == now.Date)
        {
            return local.ToString("HH:mm");
        }

        // If this year, show day/month and time
        if (local.Year == now.Year)
        {
            return local.ToString("d MMM, HH:mm");
        }

        // Otherwise show full date with time
        return local.ToString("d MMM yyyy, HH:mm");
    }

}

<div class="@GetMessageWrapperClass()" data-turn="@TurnIndex">
    @if (Message.Role != "assistant")
    {
        var (avatarUrl, displayName) = GetSenderInfo();
        <div class="message-avatar-column">
            @if (ShowAvatar)
            {
                <AvatarImage UserId="@displayName"
                             AvatarUrl="@avatarUrl"
                             Size="28" />
            }
            else
            {
                <div class="avatar-placeholder-space"></div>
            }
        </div>
    }

    <div class="@GetMessageClass()" title="@GetTooltipText()">
        <MessageAttachments Attachments="@Message.Attachments" />

        <div class="message-content">
            @if (StructuredAnswers.MealEstimateOf(Message) is { } estimate)
            {
                <MealEstimateView Estimate="estimate" />
            }
            else if (Message.Role == "assistant" && JsonOutline.Parse(Message.Content) is { } outline)
            {
                <JsonOutlineView Nodes="outline" />
            }
            else
            {
                @((MarkupString)RenderMarkdown(Message.Content))
            }
        </div>

        @{
            var timestamp = GetFormattedTimestamp();
        }
        <div class="message-footer">
            @if (Message.Versions is { } versions)
            {
                <VersionSwitcher Versions="@versions" Enabled="@(MaySwitchVersions && !IsStreaming)" OnSwitch="@OnSwitchVersion" />
            }

            @if (Message.Model is { } model && AgentModel is not null && !string.Equals(model, AgentModel, StringComparison.OrdinalIgnoreCase))
            {
                <span class="message-model" title="@model">@(RerollModels.FirstOrDefault(m => m.Id == model)?.Name ?? model)</span>
            }

            @if (Message.IsInterrupted && !IsStreaming)
            {
                <span class="message-interrupted">Stopped</span>
            }

            @if (!string.IsNullOrEmpty(timestamp))
            {
                <span class="message-timestamp">@timestamp</span>
            }

            @if (!string.IsNullOrEmpty(Message.Content))
            {
                <button class="btn-copy @(_copied ? "copied" : "")" @onclick="CopyMessage" title="Copy message">
                    @if (_copied)
                    {
                        <Icon Glyph="Icons.CheckStroked" Size="14" />
                    }
                    else
                    {
                        <Icon Glyph="Icons.Copy" Size="14" />
                    }
                </button>
            }

            @if (!IsStreaming && Actions.Count > 0)
            {
                <MessageActions Actions="@Actions" OnAction="@OnAction" Models="@RerollModels"
                                Tools="@(Message.ToolsCalled ?? [])" />
            }
        </div>

        @if (ShowRetry)
        {
            <button class="btn-retry" @onclick="OnRetry">
                <Icon Glyph="Icons.Retry" Size="14" />
                Retry
            </button>
        }
    </div>
</div>
