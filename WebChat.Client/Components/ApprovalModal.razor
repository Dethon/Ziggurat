@using System.Text.Json
@using Domain.DTOs
@using WebChat.Client.Contracts
@inherits StoreSubscriberComponent
@inject ApprovalStore ApprovalStore
@inject UserIdentityStore IdentityStore
@inject ApprovalResponder ApprovalResponder
@inject IDispatcher Dispatcher

@if (_card is { Request: var _approvalRequest })
{
    <div class="approval-modal-overlay">
        @* Answering the prompt on screen surfaces the next request waiting behind it, so which
           request is showing is the only way to tell "answered" from "replaced". *@
        <div class="approval-modal" data-approval-id="@_approvalRequest.ApprovalId">
            <div class="approval-header">
                <h3>Tool Approval Required</h3>
            </div>

            <div class="approval-content">
                @foreach (var request in _approvalRequest.Requests)
                {
                    <div class="tool-request">
                        <div class="tool-name">@FormatToolName(request.ToolName)</div>
                        @* Why the exec screen asked, as text: a request it had no part in shows no line. *@
                        @if (ExecScreenReasons.English(request.Screen) is { } reason)
                        {
                            <div class="approval-screen">@reason</div>
                        }
                        @if (request.Arguments.Count > 0)
                        {
                            <div class="tool-arguments">
                                @foreach (var (key, value) in request.Arguments)
                                {
                                    <div class="argument">
                                        <span class="argument-key">@key:</span>
                                        <span class="argument-value">@FormatValue(value)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="approval-actions">
                @* A question is its asker's: anyone else sees it and answers nothing, and one answered on
                   another of its asker's channels says so until it is closed. *@
                @if (_card.Status == ApprovalCardStatus.Answerable)
                {
                    <button class="btn btn-reject" @onclick="HandleReject" disabled="@_isResponding">
                        Reject
                    </button>
                    <button class="btn btn-always" @onclick="HandleAlways" disabled="@_isResponding">
                        Always Approve
                    </button>
                    <button class="btn btn-approve" @onclick="HandleApprove" disabled="@_isResponding">
                        Approve
                    </button>
                }
                else
                {
                    <span class="approval-status" data-testid="approval-status">
                        @(_card.Status == ApprovalCardStatus.AnsweredElsewhere
                            ? "Answered elsewhere"
                            : "Waiting for the person who asked")
                    </span>
                    <button class="btn btn-close-approval" @onclick="HandleClose">
                        Close
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private ApprovalCard? _card;
    private bool _isResponding;

    protected override void OnInitialized()
    {
        Subscribe(ApprovalStore.StateObservable,
            state => ApprovalCard.Of(state, IdentityStore.State.SignedIn?.UserId),
            card => _card = card);
        // The person may be named after the card arrived, which changes whose question it reads as.
        Subscribe(IdentityStore.StateObservable,
            identity => ApprovalCard.Of(ApprovalStore.State, identity.SignedIn?.UserId),
            card => _card = card);
    }

    // Closing a card someone else answers, or one already answered, answers nothing.
    private void HandleClose()
    {
        if (_card is { } card)
        {
            Dispatcher.Dispatch(new ClearApproval(card.Request.ApprovalId));
        }
    }

    private async Task HandleApprove() => await RespondAsync(ToolApprovalResult.Approved);

    private async Task HandleAlways() => await RespondAsync(ToolApprovalResult.ApprovedAndRemember);

    private async Task HandleReject() => await RespondAsync(ToolApprovalResult.Rejected);

    private async Task RespondAsync(ToolApprovalResult result)
    {
        if (_card is not { Status: ApprovalCardStatus.Answerable } card || _isResponding)
            return;

        _isResponding = true;
        StateHasChanged();

        try
        {
            await ApprovalResponder.RespondAsync(card.Request.ApprovalId, result);
        }
        finally
        {
            _isResponding = false;
        }
    }

    private static string FormatToolName(string toolName) => toolName.Split("__").Last();

    private static string FormatValue(object? value)
    {
        var formatted = value switch
        {
            null => "null",
            string s => s,
            JsonElement { ValueKind: JsonValueKind.String } je => je.GetString() ?? "",
            JsonElement je => je.GetRawText(),
            _ => value.ToString() ?? ""
        };
        return formatted.Length > 500 ? formatted[..500] + "..." : formatted;
    }
}
