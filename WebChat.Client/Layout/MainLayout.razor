@inherits LayoutComponentBase
@using WebChat.Client.Contracts
@implements IDisposable
@using System.Reactive.Linq
@inject IChatLiveConnection LiveConnection
@inject ConnectionStore ConnectionStore
@inject IJSRuntime Js
@inject SpaceStore SpaceStore

<div class="main-layout">
    <header class="header">
        <div class="header-title">
            <img src="/icon.svg?color=@(Uri.EscapeDataString(_accentColor))" alt="Agent" class="header-logo"/>
        </div>
        <HeaderConversation />
        <div class="header-right">
            <div class="connection-status">
                <span class="status-dot @StatusCssClass"></span>
                @StatusLabel
            </div>
            <UserIdentityPicker />
            <button class="theme-toggle" @onclick="ToggleTheme" title="Toggle theme">
                @if (_isDarkTheme)
                {
                    <!-- Sun icon for dark mode (click to switch to light) -->
                    <Icon Glyph="Icons.Sun" />
                }
                else
                {
                    <!-- Moon icon for light mode (click to switch to dark) -->
                    <Icon Glyph="Icons.Moon" />
                }
            </button>
        </div>
    </header>

    <main class="content">
        @Body
    </main>
    <ToastContainer />
</div>

@code {
    private bool _isDarkTheme;
    private bool _disposed;
    private string _accentColor = SpaceConfig.DefaultAccentColor;
    private string _spaceName = "Main";
    private ConnectionStatus _status;
    private IDisposable? _spaceSubscription;
    private IDisposable? _connectionSubscription;
    private DotNetObjectReference<MainLayout>? _selfRef;

    // The header is the third place the connection state is shown, beside ConnectionDot and
    // the chat's ConnectionStatus. Reconnecting is its own state in both of those, so it is
    // one here too — collapsing it to "not connected" made the three disagree on screen.
    private string StatusLabel => _status switch
    {
        ConnectionStatus.Connected => "Connected",
        ConnectionStatus.Reconnecting => "Reconnecting...",
        _ => "Disconnected"
    };

    private string StatusCssClass => _status switch
    {
        ConnectionStatus.Connected => "connected",
        ConnectionStatus.Reconnecting => "reconnecting",
        _ => ""
    };

    protected override Task OnInitializedAsync()
    {
        _connectionSubscription = ConnectionStore.StateObservable
            .Select(state => state.Status)
            .DistinctUntilChanged()
            .Subscribe(status => InvokeAsync(() =>
            {
                if (_disposed) return;
                _status = status;
                StateHasChanged();
            }));
        _spaceSubscription = SpaceStore.StateObservable.Subscribe(state =>
        {
            var changed = false;
            if (_accentColor != state.AccentColor)
            {
                _accentColor = state.AccentColor;
                changed = true;
            }
            if (_spaceName != state.SpaceName)
            {
                _spaceName = state.SpaceName;
                changed = true;
            }
            if (changed)
            {
                InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    var displayName = _spaceName == "Main" ? null : _spaceName;
                    await Js.InvokeVoidAsync("faviconHelper.setColor", _accentColor);
                    await Js.InvokeVoidAsync("accentHelper.setVar", _accentColor);
                    await Js.InvokeVoidAsync("faviconHelper.setSpaceTitle", displayName);
                    StateHasChanged();
                });
            }
        });
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await Js.InvokeAsync<string>("themeManager.getTheme");
            _isDarkTheme = theme == "dark";

            _selfRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("visibilityHelper.register", _selfRef);

            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnPageVisible()
    {
        await LiveConnection.ReconnectIfNeededAsync();
    }

    private async Task ToggleTheme()
    {
        var newTheme = await Js.InvokeAsync<string>("themeManager.toggleTheme");
        _isDarkTheme = newTheme == "dark";
    }

    public void Dispose()
    {
        _disposed = true;
        _connectionSubscription?.Dispose();
        _spaceSubscription?.Dispose();
        _selfRef?.Dispose();
    }
}
