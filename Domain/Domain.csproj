<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
      <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Tests" />
    </ItemGroup>

    <ItemGroup>
      <!-- Ships into the output of everything that references Domain, which is every host that
           writes a topic. That is what makes the retention policy one file rather than a block
           per host, and what puts it in each container image without a Dockerfile knowing. -->
      <Content Include="retention.json" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="delivery.json" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="token-verification.json" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="tunnel.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <!-- publicsuffix.org's list, ICANN and private sections, read by RegistrableDomain. Embedded
           rather than shipped beside the binaries: it is data the code cannot run without, not a
           policy a host may override. -->
      <EmbeddedResource Include="Tools/Web/public_suffix_list.dat" LogicalName="Domain.Tools.Web.public_suffix_list.dat" />
    </ItemGroup>

    <ItemGroup>
      <!-- The prompt documents: every section's header and words (PromptDocuments). Embedded for the
           suffix list's reason - the code's own words, not a policy a host may override. The
           repository's .dockerignore drops **/*.md, so it re-includes these by name; the target
           below turns a context that lost them into a failed build rather than a prompt-less
           container. -->
      <EmbeddedResource Include="Prompts/Sections/*.md" LogicalName="Domain.Prompts.Sections.%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="RequirePromptDocuments" BeforeTargets="BeforeBuild">
      <ItemGroup>
        <_PromptDocument Include="@(EmbeddedResource)" Condition="'%(Extension)' == '.md'" />
      </ItemGroup>
      <Error Condition="'@(_PromptDocument)' == ''"
             Text="No prompt document was found under Domain/Prompts/Sections. A build context that drops *.md (see .dockerignore) leaves every section without its words." />
    </Target>

    <ItemGroup>
      <PackageReference Include="FluentResults" Version="4.0.0" />
      <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
      <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.25.0" />
      <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
      <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    </ItemGroup>

</Project>